@{ ViewData["Title"] = "Staff Login"; }

<style>
  @@import url('https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600&family=Inter:wght@300;400;500;600&display=swap');

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --black:       #000000;
    --gray-f5:     #f5f5f7;
    --ink:         #1d1d1f;
    --blue:        #0071e3;
    --blue-dark:   #0066cc;
    --blue-light:  #2997ff;
    --white:       #ffffff;
    --gray-6e:     #6e6e73;
    --border-soft: #d2d2d7;
    --border-mid:  #86868b;
    --graphite-a:  #272729;
    --graphite-b:  #262629;
    --graphite-c:  #28282b;
    --graphite-d:  #2a2a2c;
  }

  html, body {
    height: 100%;
    background: var(--black);
    font-family: 'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  /* ── Two-column layout (mirrors student page) ── */
  .auth-page {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  /* ── Left: cinematic showcase ── */
  .auth-showcase {
    position: relative;
    background: var(--black);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 56px;
    overflow: hidden;
  }

  .auth-showcase::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 60% at 30% 20%, rgba(41,151,255,0.09) 0%, transparent 70%),
      radial-gradient(ellipse 50% 40% at 80% 80%, rgba(0,113,227,0.07) 0%, transparent 60%);
    pointer-events: none;
  }

  .showcase-wordmark {
    position: absolute;
    top: 48px; left: 56px;
    display: flex; align-items: center; gap: 10px;
  }

  .wordmark-dot {
    width: 30px; height: 30px;
    border-radius: 50%;
    background: var(--blue);
  }

  .wordmark-text {
    font-family: 'Inter Tight', 'Helvetica Neue', sans-serif;
    font-size: 14px; font-weight: 600;
    color: var(--white);
    letter-spacing: 0.02em; opacity: 0.9;
  }

  /* Abstract visual — two overlapping shield shapes */
  .showcase-visual {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -54%);
    width: 320px; height: 320px;
  }

  .shield-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.05);
    top: 50%; left: 50%;
    transform: translate(-50%,-50%);
  }
  .shield-ring:nth-child(1) { width: 180px; height: 180px; border-color: rgba(41,151,255,0.30); }
  .shield-ring:nth-child(2) { width: 300px; height: 300px; border-color: rgba(255,255,255,0.07); }
  .shield-ring:nth-child(3) { width: 380px; height: 380px; border-color: rgba(255,255,255,0.04); }
    .shield-ring:nth-child(4) { width: 480px; height: 480px; border-color: rgba(255,255,255,0.04); }

  .shield-core {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 72px; height: 72px;
    border-radius: 22px;
    background: var(--graphite-a);
    border: 1px solid rgba(255,255,255,0.12);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 40px rgba(41,151,255,0.15), 0 0 80px rgba(41,151,255,0.06);
  }

  .shield-core svg {
    width: 28px; height: 28px;
    stroke: var(--blue-light);
  }

  /* Orbit dot */
  .orbit-dot {
    position: absolute;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--blue-light);
    top: 50%; left: 50%;
    animation: orbit 10s linear infinite;
    opacity: 0.7;
    will-change: transform;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }
  .orbit-dot:nth-child(5) { animation-delay: -5s; opacity: 0.35; }

  @@keyframes orbit {
    from { transform: rotate(0deg) translateX(100px) rotate(0deg); }
    to   { transform: rotate(360deg) translateX(100px) rotate(-360deg); }
  }

  .showcase-copy { position: relative; z-index: 2; }

  .showcase-eyebrow {
    font-size: 12px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--blue-light); margin-bottom: 16px;
  }

  .showcase-headline {
    font-family: 'Inter Tight', 'Helvetica Neue', sans-serif;
    font-size: 48px; font-weight: 600;
    line-height: 1.05; letter-spacing: -0.02em;
    color: var(--white); margin-bottom: 20px;
  }

  .showcase-headline span { color: var(--blue-light); }

  .showcase-body {
    font-size: 17px; font-weight: 400;
    line-height: 1.47; color: var(--gray-6e);
    max-width: 340px;
  }

  .showcase-pills {
    display: flex; gap: 8px; margin-top: 32px; flex-wrap: wrap;
  }

  .showcase-pill {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 14px; border-radius: 980px;
    border: 1px solid rgba(255,255,255,0.12);
    font-size: 12px; color: rgba(255,255,255,0.5);
  }

  /* ── Right: form panel ── */
  .auth-form-panel {
    background: var(--gray-f5);
    display: flex; align-items: center; justify-content: center;
    padding: 40px;
  }

  .auth-card {
    width: 100%; max-width: 500px;
    background: var(--white);
    border-radius: 18px;
    border: 1px solid var(--border-soft);
    padding: 44px 40px 40px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06), 0 8px 32px rgba(0,0,0,0.06);
  }

  /* Icon */
  .card-icon {
    width: 48px; height: 48px;
    border-radius: 14px;
    background: var(--black);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 28px;
  }

  .card-icon svg { width: 20px; height: 20px; stroke: var(--white); }

  /* Header */
  .card-title {
    font-family: 'Inter Tight', 'Helvetica Neue', sans-serif;
    font-size: 28px; font-weight: 600;
    line-height: 1.14; letter-spacing: -0.01em;
    color: var(--ink); margin-bottom: 6px;
  }

  .card-subtitle {
    font-size: 17px; color: var(--gray-6e);
    margin-bottom: 28px; line-height: 1.47;
  }

  /* ── Role toggle ── */
  .role-toggle {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    background: var(--gray-f5);
    border-radius: 10px;
    padding: 3px;
    margin-bottom: 28px;
    border: 1px solid var(--border-soft);
  }

  .role-btn {
    display: flex; align-items: center; justify-content: center; gap: 7px;
    padding: 9px 12px;
    border-radius: 8px;
    border: none;
    background: transparent;
    font-family: 'Inter', sans-serif;
    font-size: 14px; font-weight: 600;
    color: var(--gray-6e);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, box-shadow 0.15s;
    white-space: nowrap;
  }

  .role-btn svg {
    width: 14px; height: 14px;
    stroke: currentColor; flex-shrink: 0;
  }

  .role-btn.active {
    background: var(--white);
    color: var(--ink);
    box-shadow: 0 1px 4px rgba(0,0,0,0.10);
  }

  /* Error */
  .auth-alert {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 14px 16px; border-radius: 12px; margin-bottom: 24px;
    background: rgba(255,59,48,0.06);
    border: 1px solid rgba(255,59,48,0.18);
  }
  .alert-icon { font-size: 16px; flex-shrink: 0; margin-top: 1px; color: #ff3b30; }
  .auth-alert strong { display: block; font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 2px; }
  .auth-alert p { font-size: 13px; color: var(--gray-6e); line-height: 1.4; }

  /* Form */
  .login-form { display: flex; flex-direction: column; gap: 16px; }
  .field-group { display: flex; flex-direction: column; gap: 6px; }

  .field-group label {
    font-size: 14px; font-weight: 600;
    color: var(--ink); letter-spacing: -0.01em;
  }

  .input-wrap { position: relative; }

  .input-wrap svg {
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    width: 16px; height: 16px; stroke: var(--border-mid);
    pointer-events: none; transition: stroke 0.15s;
  }

  .cortex-input {
    width: 100%;
    padding: 12px 14px 12px 42px;
    border-radius: 10px;
    border: 1px solid var(--border-soft);
    background: var(--white);
    font-family: 'Inter', sans-serif;
    font-size: 12px; color: var(--ink);
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    -webkit-appearance: none;
  }

  .cortex-input::placeholder { color: var(--border-mid); }

  .cortex-input:focus {
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(0,113,227,0.15);
  }

  .cortex-input:focus ~ svg { stroke: var(--blue); }

  .field-footer { display: flex; justify-content: flex-end; margin-top: 2px; }

  .forgot-link {
    font-size: 12px; color: var(--blue-dark);
    text-decoration: none;
  }
  .forgot-link:hover { text-decoration: underline; }

  /* Submit */
  .btn-primary {
    display: block; width: 100%;
    padding: 14px; margin-top: 8px;
    border-radius: 980px; border: none;
    background: var(--blue);
    color: var(--white);
    font-family: 'Inter', sans-serif;
    font-size: 17px; font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
    transition: background 0.15s, transform 0.1s;
  }
  .btn-primary:hover  { background: var(--blue-dark); }
  .btn-primary:active { transform: scale(0.98); background: #005bbf; }

  /* Divider */
  .card-divider { height: 1px; background: var(--border-soft); margin: 28px 0; }

  /* Footer */
  .card-footer { display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .card-footer p { font-size: 14px; color: var(--gray-6e); }
  .back-link {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 12px; color: var(--gray-6e);
    text-decoration: none;
    padding: 6px 12px; border-radius: 980px;
    border: 1px solid var(--border-soft);
    transition: border-color 0.15s, color 0.15s;
  }
  .back-link:hover { color: var(--ink); border-color: var(--border-mid);  text-decoration: none; }

  /* ── Mobile ── */
  @@media (max-width: 768px) {
    .auth-page { grid-template-columns: 1fr; }
    .auth-showcase { display: none; }
    .auth-form-panel {
      min-height: 100vh;
      background: var(--black);
      padding: 24px 20px;
    }
    .auth-card {
      border-color: rgba(255,255,255,0.08);
      background: var(--graphite-a);
      box-shadow: none;
    }
    .card-title, .field-group label { color: var(--white); }
    .card-subtitle { color: var(--gray-6e); }
    .role-toggle { background: var(--graphite-b); border-color: rgba(255,255,255,0.1); }
    .role-btn.active { background: var(--graphite-d); color: var(--white); }
    .cortex-input { background: var(--graphite-b); border-color: rgba(255,255,255,0.12); color: var(--white); }
    .cortex-input::placeholder { color: rgba(255,255,255,0.25); }
    .cortex-input:focus { border-color: var(--blue-light); box-shadow: 0 0 0 3px rgba(41,151,255,0.15); }
    .card-divider { background: rgba(255,255,255,0.08); }
    .card-footer p { color: rgba(255,255,255,0.4); }
    .back-link { color: rgba(255,255,255,0.4); border-color: rgba(255,255,255,0.12); }
    .back-link:hover { color: var(--white); }
  }
</style>

<div class="auth-page">

  <!-- ── Left showcase ── -->
  <div class="auth-showcase">
    <div class="showcase-wordmark">
      <div class="wordmark-dot"></div>
      <span class="wordmark-text">PaScan</span>
    </div>

    <div class="showcase-visual">
      <div class="shield-ring"></div>
      <div class="shield-ring"></div>
      <div class="shield-ring"></div>
      <div class="shield-ring"></div>
      <div class="shield-core">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>
      <div class="orbit-dot"></div>
      <div class="orbit-dot"></div>
    </div>

    <div class="showcase-copy">
      <p class="showcase-eyebrow">Staff Access</p>
      <h1 class="showcase-headline">Secure.<br><span>Controlled.</span><br>Simple.</h1>
      <p class="showcase-body">Manage approvals, monitor devices, and operate gate access — all from one console.</p>
      <div class="showcase-pills">
        <div class="showcase-pill">Admin Console</div>
        <div class="showcase-pill">Gate Scanner</div>
      </div>
    </div>
  </div>

  <!-- ── Right form ── -->
  <div class="auth-form-panel">
    <div class="auth-card">

      <div class="card-icon">
        <svg id="card-icon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <!-- default: lock / admin -->
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>

      <h1 class="card-title" id="card-title">Staff Portal</h1>
      <p class="card-subtitle" id="card-subtitle">Admin Console</p>

      <!-- Role toggle -->
      <div class="role-toggle" role="tablist" aria-label="Select role">
        <button type="button" class="role-btn active" id="btn-admin" role="tab" aria-selected="true" onclick="setRole('admin')">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          Admin
        </button>
        <button type="button" class="role-btn" id="btn-scanner" role="tab" aria-selected="false" onclick="setRole('scanner')">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
          Scanner
        </button>
      </div>

      @if (ViewBag.Error != null)
      {
        <div class="auth-alert">
          <span class="alert-icon">⚠</span>
          <div>
            <strong>Authentication Failed</strong>
            <p>@ViewBag.Error</p>
          </div>
        </div>
      }

      <form method="post" class="login-form" id="staff-form" action="/auth/login/admin">
        <input type="hidden" name="role" id="role-input" value="admin" />

        <div class="field-group">
          <label for="email" id="email-label">Email</label>
          <div class="input-wrap">
            <input
              class="cortex-input"
              id="email"
              name="email"
              type="email"
              placeholder="Email"
              autocomplete="username"
              required />
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
        </div>

        <div class="field-group">
          <label for="password">Password</label>
          <div class="input-wrap">
            <input
              class="cortex-input"
              id="password"
              name="password"
              type="password"
              placeholder="••••••••"
              autocomplete="current-password"
              required />
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <div class="field-footer">
            <a href="#" class="forgot-link">Forgot password?</a>
          </div>
        </div>

        <button class="btn-primary" type="submit" id="submit-btn">Sign In</button>
      </form>

      <div class="card-divider"></div>

      <div class="card-footer">
        <a href="/auth/login" class="back-link">← Other Portals</a>
      </div>
    </div>
  </div>

</div>

<script>
  const adminIconPath = `<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>`;
  const scannerIconPath = `<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>`;

  function setRole(role) {
    const isAdmin = role === 'admin';

    // Toggle active state
    document.getElementById('btn-admin').classList.toggle('active', isAdmin);
    document.getElementById('btn-scanner').classList.toggle('active', !isAdmin);
    document.getElementById('btn-admin').setAttribute('aria-selected', isAdmin);
    document.getElementById('btn-scanner').setAttribute('aria-selected', !isAdmin);

    // Update hidden input & form action
    document.getElementById('role-input').value = role;
    document.getElementById('staff-form').action = isAdmin
      ? '/auth/login/admin'
      : '/auth/login/scanner';

    // Update copy
    document.getElementById('card-subtitle').textContent = isAdmin ? 'Admin Console' : 'Gate Scanner';

    // Swap icon
    document.getElementById('card-icon-svg').innerHTML = isAdmin ? adminIconPath : scannerIconPath;
  }
</script>
