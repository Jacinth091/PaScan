@{ ViewData["Title"] = "Select Portal"; }

<style>
  @@import url('https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600&family=Inter:wght@300;400;500;600&display=swap');

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --black:       #000000;
    --gray-f5:     #f5f5f7;
    --ink:         #1d1d1f;
    --blue:        #0071e3;
    --blue-dark:   #0066cc;
    --blue-light:  #2997ff;
    --white:       #ffffff;
    --gray-6e:     #6e6e73;
    --border-soft: #d2d2d7;
    --border-mid:  #86868b;
    --graphite-a:  #272729;
    --graphite-b:  #262629;
    --graphite-c:  #28282b;
  }

  html, body {
    height: 100%;
    background: var(--black);
    font-family: 'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  /* ── Full-page layout ── */
  .selector-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
    position: relative;
    overflow: hidden;
  }

  /* Ambient glow bg */
  .selector-page::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 20% 10%, rgba(0,113,227,0.10) 0%, transparent 60%),
      radial-gradient(ellipse 50% 40% at 80% 90%, rgba(41,151,255,0.07) 0%, transparent 60%);
    pointer-events: none;
  }

  /* ── Wordmark ── */
  .page-wordmark {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 56px;
    animation: fadeUp 0.6s ease both;
    will-change: opacity, transform;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .wordmark-dot {
    width: 30px; height: 30px;
    border-radius: 50%;
    background: var(--blue);
  }

  .wordmark-text {
    font-family: 'Inter Tight', 'Helvetica Neue', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--white);
    letter-spacing: 0.02em;
  }

  /* ── Hero text ── */
  .selector-hero {
    text-align: center;
    margin-bottom: 48px;
    animation: fadeUp 0.6s ease 0s both;
    will-change: opacity, transform;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .selector-eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue-light);
    margin-bottom: 14px;
  }

  .selector-title {
    font-family: 'Inter Tight', 'Helvetica Neue', sans-serif;
    font-size: 48px;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--white);
    margin-bottom: 14px;
  }

  .selector-subtitle {
    font-size: 17px;
    color: var(--gray-6e);
    line-height: 1.47;
  }

  /* ── Cards grid ── */
  .portal-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    width: 100%;
    max-width: 640px;
    animation: fadeUp 0.6s ease 0s both;
    will-change: opacity, transform;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .portal-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 32px 28px 28px;
    background: var(--graphite-a);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 18px;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s, background 0.2s;
    overflow: hidden;
  }

  .portal-card::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.25s;
    border-radius: inherit;
  }

  .portal-card--student::before {
    background: radial-gradient(ellipse 80% 60% at 20% 20%, rgba(0,113,227,0.12) 0%, transparent 70%);
  }

  .portal-card--staff::before {
    background: radial-gradient(ellipse 80% 60% at 20% 20%, rgba(41,151,255,0.10) 0%, transparent 70%);
  }

  .portal-card:hover {
    text-decoration: none;
    border-color: rgba(255,255,255,0.18);
    transform: translateY(-3px);
    background: var(--graphite-c);
  }

  .portal-card:hover::before { opacity: 1; }

  .portal-card:active { transform: translateY(-1px) scale(0.99); }

  /* Icon */
  .card-icon-wrap {
    width: 44px; height: 44px;
    border-radius: 12px;
    background: rgba(0,113,227,0.15);
    border: 1px solid rgba(0,113,227,0.25);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 20px;
  }

  .portal-card--staff .card-icon-wrap {
    background: rgba(41,151,255,0.12);
    border-color: rgba(41,151,255,0.22);
  }

  .card-icon-wrap svg {
    width: 20px; height: 20px;
    stroke: var(--blue-light);
  }

  /* Card text */
  .card-label {
    font-family: 'Inter Tight', 'Helvetica Neue', sans-serif;
    font-size: 21px;
    font-weight: 600;
    color: var(--white);
    line-height: 1.14;
    letter-spacing: -0.01em;
    margin-bottom: 8px;
  }

  .card-desc {
    font-size: 14px;
    color: var(--gray-6e);
    line-height: 1.47;
    flex: 1;
  }

  /* Role pills (staff only) */
  .card-roles {
    display: flex;
    gap: 6px;
    margin-top: 20px;
    flex-wrap: wrap;
  }

  .role-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 980px;
    border: 1px solid rgba(255,255,255,0.1);
    font-size: 11px;
    font-weight: 500;
    color: rgba(255,255,255,0.45);
    letter-spacing: 0.01em;
  }


  /* Arrow */
  .card-arrow {
    position: absolute;
    top: 28px; right: 28px;
    font-size: 16px;
    color: rgba(255,255,255,0.2);
    transition: color 0.2s, transform 0.2s;
  }

  .portal-card:hover .card-arrow {
    color: var(--blue-light);
    transform: translateX(3px);
  }

  /* ── Footer ── */
  .selector-footer {
    margin-top: 36px;
    text-align: center;
    animation: fadeUp 0.6s ease 0s both;
    will-change: opacity, transform;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .selector-footer p {
    font-size: 14px;
    color: var(--gray-6e);
    margin-bottom: 10px;
  }

  .selector-footer p a {
    color: var(--blue-dark);
    text-decoration: none;
    font-weight: 600;
  }

  .selector-footer p a:hover { text-decoration: underline; }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: rgba(255,255,255,0.3);
    text-decoration: none;
    padding: 6px 14px;
    border-radius: 980px;
    border: 1px solid rgba(255,255,255,0.1);
    transition: color 0.15s, border-color 0.15s;
  }

  .back-link:hover { color: var(--white); border-color: rgba(255,255,255,0.2); text-decoration: none;}

  /* ── Animations ── */
  @@keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Responsive ── */
  @@media (max-width: 520px) {
    .portal-cards { grid-template-columns: 1fr; max-width: 360px; }
    .selector-title { font-size: 36px; }
    .selector-page { padding: 32px 20px; }
    .selector-hero { margin-bottom: 36px; }
    .page-wordmark { margin-bottom: 40px; }
  }
</style>

<div class="selector-page">

  <div class="page-wordmark">
    <img src="~/images/logo.svg" alt="PaScan Logo" class="brand-logo" style="width: 32px; height: 32px;" />
    <span class="wordmark-text">PaScan</span>
  </div>

  <div class="selector-hero">
    <p class="selector-eyebrow">Access Portal</p>
    <h1 class="selector-title">Who are you?</h1>
    <p class="selector-subtitle">Select your access level to continue.</p>
  </div>

  <div class="portal-cards">

    <!-- Student -->
    <a href="/auth/login/student" class="portal-card portal-card--student">
      <span class="card-arrow">→</span>
      <div class="card-icon-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </div>
      <h3 class="card-label">Student</h3>
      <p class="card-desc">Request passes &amp; manage your devices</p>
    </a>

    <!-- Staff (Admin + Scanner merged) -->
    <a href="/auth/login/admin" class="portal-card portal-card--staff">
      <span class="card-arrow">→</span>
      <div class="card-icon-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>
      <h3 class="card-label">Staff</h3>
      <p class="card-desc">Admin console &amp; gate scanner access</p>
      <div class="card-roles">
        <span class="role-pill">Admin</span>
        <span class="role-pill">Scanner</span>
      </div>
    </a>

  </div>

  <div class="selector-footer">
    <p>No account? <a href="/auth/register/student">Register here</a></p>
    <a href="/" class="back-link">← Back to home</a>
  </div>

</div>
