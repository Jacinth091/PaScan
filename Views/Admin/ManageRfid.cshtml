@model PaScan.Models.ViewModels.AdminStudentDetailViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Manage RFID Card";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">Manage RFID Card</h2>
                <a asp-action="StudentDetail" asp-route-id="@Model.Student.Id" class="btn btn-sm btn-link text-decoration-none">
                    <i class="bi bi-arrow-left"></i> Back to Profile
                </a>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4 text-center">
                    <h5 class="mb-1">@Model.Student.FirstName @Model.Student.LastName</h5>
                    <p class="text-muted small mb-0">@Model.Student.StudentNumber</p>
                </div>
            </div>

            <div class="card shadow-sm border-0 border-top border-success border-4">
                <div class="card-body p-4 p-md-5">
                    @if (Model.ActiveRfid != null)
                    {
                        <div class="text-center mb-4">
                            <i class="bi bi-credit-card-2-front text-success" style="font-size: 4rem;"></i>
                            <h4 class="mt-3 font-monospace">@Model.ActiveRfid.CardUid</h4>
                            <span class="badge bg-success mb-2">ACTIVE</span>
                            <p class="text-muted small">Expires: @Model.ActiveRfid.SemesterExpiresAt.ToString("MMMM dd, yyyy")</p>
                        </div>

                        <div class="d-grid gap-3">
                            <a asp-action="RenewRfid" asp-route-id="@Model.Student.Id" class="btn btn-outline-primary py-3 rounded-3">
                                <div class="d-flex align-items-center justify-content-center">
                                    <i class="bi bi-calendar-plus fs-4 me-3"></i>
                                    <div class="text-start">
                                        <div class="fw-bold">Renew Semester</div>
                                        <div class="small">Extend the expiry date of this card.</div>
                                    </div>
                                </div>
                            </a>

                            <a asp-action="ReplaceRfid" asp-route-id="@Model.Student.Id" class="btn btn-outline-warning py-3 rounded-3">
                                <div class="d-flex align-items-center justify-content-center">
                                    <i class="bi bi-arrow-repeat fs-4 me-3"></i>
                                    <div class="text-start">
                                        <div class="fw-bold">Replace Card</div>
                                        <div class="small">Issue a new card to replace a lost or damaged one.</div>
                                    </div>
                                </div>
                            </a>

                            <a asp-action="RevokeRfid" asp-route-id="@Model.Student.Id" class="btn btn-outline-danger py-3 rounded-3">
                                <div class="d-flex align-items-center justify-content-center">
                                    <i class="bi bi-x-circle fs-4 me-3"></i>
                                    <div class="text-start">
                                        <div class="fw-bold">Revoke Card</div>
                                        <div class="small">Permanently invalidate the current card without replacing it.</div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <p class="text-muted mb-4">This student does not have an active RFID card.</p>
                            <a asp-action="IssueRfid" asp-route-id="@Model.Student.Id" class="btn btn-primary rounded-pill px-4">Issue New Card</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
