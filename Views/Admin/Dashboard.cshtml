@model PaScan.Models.ViewModels.AdminDashboardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="adm-page-header adm-rise">
    <p class="adm-page-kicker">Dashboard</p>
    <div class="adm-page-header-row">
        <h1 class="adm-page-title">Administrative Overview</h1>
        <span class="adm-text-muted" style="font-size:0.88rem;">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="adm-alert adm-alert--success adm-rise adm-rise-d1">
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
    </div>
}

<!-- Stats Row -->
<div class="adm-stats-row adm-rise adm-rise-d1">
    <div class="adm-stat-card">
        <div class="adm-stat-icon" style="color:#ffb300;"><i class="bi bi-clock-history"></i></div>
        <div class="adm-stat-label">Pending Requests</div>
        <div class="adm-stat-value warning">@Model.PendingRequestCount</div>
        <a asp-action="Requests" class="adm-btn-ghost adm-btn-sm" style="margin-top:0.75rem;">View Queue</a>
    </div>
    <div class="adm-stat-card">
        <div class="adm-stat-icon" style="color:#32d74b;"><i class="bi bi-laptop"></i></div>
        <div class="adm-stat-label">Active Devices</div>
        <div class="adm-stat-value success">@Model.ActiveDeviceCount</div>
    </div>
    <div class="adm-stat-card">
        <div class="adm-stat-icon" style="color:#2196F3;"><i class="bi bi-people"></i></div>
        <div class="adm-stat-label">Total Students</div>
        <div class="adm-stat-value blue">@Model.TotalStudentCount</div>
    </div>
    <div class="adm-stat-card">
        <div class="adm-stat-icon" style="color:#4fc3f7;"><i class="bi bi-qr-code-scan"></i></div>
        <div class="adm-stat-label">Today's Scans</div>
        <div class="adm-stat-value info">@Model.TodayScanCount</div>
    </div>
</div>

<div class="adm-row adm-rise adm-rise-d2">
    <!-- Recent Requests -->
    <div>
        <div class="adm-card">
            <div class="adm-card-header">
                <h2 class="adm-card-title">Recent Pending Requests</h2>
                <a asp-action="Requests" class="adm-btn-ghost adm-btn-sm">View All</a>
            </div>
            @if (Model.RecentPendingRequests.Any())
            {
                @foreach (var req in Model.RecentPendingRequests)
                {
                    <div class="adm-list-item">
                        <div>
                            <div class="adm-list-item-title">@req.StudentName</div>
                            <div class="adm-list-item-sub">@req.Brand @req.Model (@req.DeviceType)</div>
                        </div>
                        <a asp-action="RequestDetail" asp-route-id="@req.Id" class="adm-btn-ghost adm-btn-sm">Review</a>
                    </div>
                }
            }
            else
            {
                <div class="adm-text-muted adm-text-center" style="padding:2rem 0;">No pending requests</div>
            }
        </div>
    </div>

    <!-- Active Scanners -->
    <div>
        <div class="adm-card">
            <div class="adm-card-header">
                <h2 class="adm-card-title">Active Scanners</h2>
                <a asp-action="Scanners" class="adm-btn-ghost adm-btn-sm">Manage</a>
            </div>
            @if (Model.ActiveScanners.Any())
            {
                @foreach (var scanner in Model.ActiveScanners)
                {
                    <div class="adm-list-item">
                        <div>
                            <div class="adm-list-item-title">@scanner.Name</div>
                            <div class="adm-list-item-sub">@scanner.Location &bull; @scanner.ScannerType</div>
                        </div>
                        <span class="adm-badge adm-badge--active">ACTIVE</span>
                    </div>
                }
            }
            else
            {
                <div class="adm-text-muted adm-text-center" style="padding:2rem 0;">No active scanners</div>
            }
        </div>
    </div>
</div>

<!-- Recent Gate Activity -->
<div class="adm-card adm-rise adm-rise-d3" style="margin-top:0;">
    <div class="adm-card-header">
        <h2 class="adm-card-title">Recent Gate Activity</h2>
    </div>
    <div class="adm-table-wrap">
        <table class="adm-table paginated-table">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Device</th>
                    <th>Scanner</th>
                    <th>Time</th>
                    <th style="text-align:right;">Result</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentScanLogs.Any())
                {
                    @foreach (var log in Model.RecentScanLogs)
                    {
                        <tr>
                            <td>@log.StudentName</td>
                            <td>@log.DeviceName <span class="adm-info-chip" style="margin-left:0.3rem;">@log.ScanType</span></td>
                            <td>@log.ScannerName</td>
                            <td>@log.ScannedAt.ToString("HH:mm")</td>
                            <td style="text-align:right;">
                                @if (log.IsAllowed)
                                {
                                    <span class="adm-badge adm-badge--active">ALLOWED</span>
                                }
                                else
                                {
                                    <span class="adm-badge adm-badge--rejected" title="@log.DenialReason">DENIED</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="adm-table-empty">No scan logs today</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
