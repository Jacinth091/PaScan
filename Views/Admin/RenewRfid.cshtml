@model PaScan.Models.ViewModels.AdminStudentDetailViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Renew RFID Semester";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">Renew Semester</h2>
                <a asp-action="ManageRfid" asp-route-id="@Model.Student.Id" class="btn btn-sm btn-link text-decoration-none">
                    <i class="bi bi-arrow-left"></i> Back to Manage
                </a>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4 text-center">
                    <h5 class="mb-1">@Model.Student.FirstName @Model.Student.LastName</h5>
                    <p class="text-muted small mb-0">@Model.Student.StudentNumber</p>
                </div>
            </div>

            <div class="card shadow-sm border-0 border-top border-primary border-4">
                <div class="card-body p-4 p-md-5">
                    @if (Model.ActiveRfid != null)
                    {
                        <div class="alert alert-info mb-4">
                            <i class="bi bi-info-circle-fill me-2"></i> Current Expiry: <strong>@Model.ActiveRfid.SemesterExpiresAt.ToString("MMM dd, yyyy")</strong>
                        </div>

                        <form asp-action="RenewRfidSemester" asp-route-studentId="@Model.Student.Id" method="post">
                            @Html.AntiForgeryToken()
                            
                            <div class="mb-5">
                                <label class="form-label small fw-bold text-uppercase">New Semester Expiry Date</label>
                                <input type="date" name="semesterExpiresAt" class="form-control form-control-lg" required value="@DateTime.Now.AddMonths(5).ToString("yyyy-MM-dd")" />
                                <div class="form-text text-muted mt-2">Select the end date for the new semester. Default is set to +5 months.</div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-pill shadow-sm">
                                Confirm Renewal
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
