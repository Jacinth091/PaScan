@model PaScan.Models.ViewModels.AdminStudentListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Students";
}

<div class="adm-page-header adm-rise">
    <p class="adm-page-kicker">Management</p>
    <h1 class="adm-page-title">Student Directory</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="adm-alert adm-alert--success adm-rise"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="adm-alert adm-alert--error adm-rise"><i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]</div>
}

<div class="adm-card adm-rise adm-rise-d1">
    <div class="adm-table-wrap">
        <table class="adm-table paginated-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Student Number</th>
                    <th>Course</th>
                    <th>RFID</th>
                    <th>Status</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Students.Any())
                {
                    <tr><td colspan="6" class="adm-table-empty">No students found.</td></tr>
                }
                else
                {
                    @foreach (var student in Model.Students)
                    {
                        <tr>
                            <td>
                                <div style="display:flex;align-items:center;gap:0.6rem;">
                                    <div class="adm-avatar adm-avatar--sm">@student.FirstName[0]@student.LastName[0]</div>
                                    <span>@student.FirstName @student.LastName</span>
                                </div>
                            </td>
                            <td><span class="adm-text-mono" style="color:#a1a1a6;">@student.StudentNumber</span></td>
                            <td>@(student.Course?.Name ?? "N/A")</td>
                            <td>
                                @if (student.IsRfidEnabled)
                                {
                                    <span style="color:#32d74b;" title="RFID Active"><i class="bi bi-credit-card-2-front-fill"></i></span>
                                }
                                else
                                {
                                    <span class="adm-text-muted" title="No RFID"><i class="bi bi-credit-card-2-front"></i></span>
                                }
                            </td>
                            <td>
                                @if (student.IsActive)
                                {
                                    <span class="adm-badge adm-badge--active">ACTIVE</span>
                                }
                                else
                                {
                                    <span class="adm-badge adm-badge--inactive">INACTIVE</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <a asp-action="StudentDetail" asp-route-id="@student.Id" class="adm-btn-ghost adm-btn-sm">View Profile</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
