@model PaScan.Models.ViewModels.AdminStudentListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Students";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Student Directory</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Student Number</th>
                        <th>Course</th>
                        <th>RFID</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Students.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <p class="mb-0">No students found.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var student in Model.Students)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm bg-light text-primary rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-weight: bold; font-size: 0.8rem;">
                                            @student.FirstName[0]@student.LastName[0]
                                        </div>
                                        <div>@student.FirstName @student.LastName</div>
                                    </div>
                                </td>
                                <td><code>@student.StudentNumber</code></td>
                                <td>@(student.Course?.Name ?? "N/A")</td>
                                <td>
                                    @if (student.IsRfidEnabled)
                                    {
                                        <span class="text-success" title="RFID Active"><i class="bi bi-credit-card-2-front-fill"></i></span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" title="No RFID"><i class="bi bi-credit-card-2-front"></i></span>
                                    }
                                </td>
                                <td>
                                    @if (student.IsActive)
                                    {
                                        <span class="badge bg-success">ACTIVE</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark">INACTIVE</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="StudentDetail" asp-route-id="@student.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        View Profile
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
