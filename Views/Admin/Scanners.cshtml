@model PaScan.Models.ViewModels.ScannerListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Scanner Management";
}

<div class="adm-page-header adm-rise">
    <p class="adm-page-kicker">Infrastructure</p>
    <div class="adm-page-header-row">
        <h1 class="adm-page-title">Scanner Management</h1>
        <a asp-action="CreateScanner" class="adm-btn-primary">
            <i class="bi bi-plus-lg"></i> Add Scanner
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="adm-alert adm-alert--success adm-rise"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<div class="adm-card adm-rise adm-rise-d1">
    <div class="adm-table-wrap">
        <table class="adm-table paginated-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Location</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Scanners.Any())
                {
                    @foreach (var scanner in Model.Scanners)
                    {
                        <tr>
                            <td style="font-weight:600; color:#e8e8ed;">@scanner.Name</td>
                            <td>@scanner.Location</td>
                            <td><span class="adm-info-chip">@scanner.ScannerType</span></td>
                            <td>
                                @if (scanner.Status == PaScan.Enums.ScannerStatus.ACTIVE)
                                {
                                    <span class="adm-badge adm-badge--active">ACTIVE</span>
                                }
                                else
                                {
                                    <span class="adm-badge adm-badge--rejected">@scanner.Status</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <a asp-action="EditScanner" asp-route-id="@scanner.Id" class="adm-btn-ghost adm-btn-sm">Edit Configuration</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="adm-table-empty">No scanners registered.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
