@model PaScan.Models.ViewModels.ScannerListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Scanner Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Scanner Management</h2>
        <div>
            <a asp-action="CreateScanner" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-plus-lg me-1"></i> Add Scanner
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Name</th>
                        <th>Location</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Scanners.Any())
                    {
                        @foreach (var scanner in Model.Scanners)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@scanner.Name</td>
                                <td>@scanner.Location</td>
                                <td><span class="badge bg-light text-dark border">@scanner.ScannerType</span></td>
                                <td>
                                    @if (scanner.Status == PaScan.Enums.ScannerStatus.ACTIVE)
                                    {
                                        <span class="badge bg-success">ACTIVE</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@scanner.Status</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="EditScanner" asp-route-id="@scanner.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        Edit Configuration
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <p class="mb-0">No scanners registered.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
