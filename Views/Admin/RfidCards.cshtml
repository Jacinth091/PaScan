@model PaScan.Models.ViewModels.AdminRfidListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "RFID Management";
}

<div class="adm-page-header adm-rise">
    <p class="adm-page-kicker">Credentials</p>
    <div class="adm-page-header-row">
        <h1 class="adm-page-title">RFID Master List</h1>
        <span class="adm-text-muted" style="font-size:0.88rem;">@Model.RfidCards.Count Total Issued Cards</span>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="adm-alert adm-alert--success adm-rise"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<div class="adm-card adm-rise adm-rise-d1">
    <div class="adm-table-wrap">
        <table class="adm-table paginated-table">
            <thead>
                <tr>
                    <th>Card UID</th>
                    <th>Student / Owner</th>
                    <th>Issued At</th>
                    <th>Semester Expiry</th>
                    <th>Status</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.RfidCards.Any())
                {
                    <tr><td colspan="6" class="adm-table-empty">No RFID cards issued yet.</td></tr>
                }
                else
                {
                    @foreach (var card in Model.RfidCards)
                    {
                        <tr>
                            <td><span class="adm-text-mono" style="font-weight:600; color:#e8e8ed;">@card.CardUid</span></td>
                            <td>
                                @if (card.Student != null)
                                {
                                    <a asp-action="StudentDetail" asp-route-id="@card.StudentId" style="color:#2196F3; text-decoration:none; font-weight:600;">
                                        @card.Student.FirstName @card.Student.LastName
                                    </a>
                                    <div class="adm-list-item-sub">@card.Student.StudentNumber</div>
                                }
                                else
                                {
                                    <span class="adm-text-muted">Orphaned Card</span>
                                }
                            </td>
                            <td>@card.IssuedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                @card.SemesterExpiresAt.ToString("MMM dd, yyyy")
                                @if (card.SemesterExpiresAt < DateTime.UtcNow && card.Status == PaScan.Enums.TokenStatus.ACTIVE)
                                {
                                    <span style="margin-left:0.3rem; color:#ff453a;" title="Semester Expired"><i class="bi bi-exclamation-triangle"></i></span>
                                }
                            </td>
                            <td>
                                @switch (card.Status)
                                {
                                    case PaScan.Enums.TokenStatus.ACTIVE:
                                        <span class="adm-badge adm-badge--active">ACTIVE</span>
                                        break;
                                    case PaScan.Enums.TokenStatus.REVOKED:
                                        <span class="adm-badge adm-badge--revoked">REVOKED</span>
                                        break;
                                    case PaScan.Enums.TokenStatus.EXPIRED:
                                        <span class="adm-badge adm-badge--expired">EXPIRED</span>
                                        break;
                                    default:
                                        <span class="adm-badge adm-badge--inactive">@card.Status</span>
                                        break;
                                }
                            </td>
                            <td style="text-align:right;">
                                <a asp-action="StudentDetail" asp-route-id="@card.StudentId" class="adm-btn-ghost adm-btn-sm">Manage Owner</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
