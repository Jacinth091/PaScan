@model PaScan.Models.ViewModels.AdminDeviceListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Devices";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Managed Devices</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Device</th>
                        <th>Type</th>
                        <th>Owner</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Devices.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <p class="mb-0">No devices found.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var device in Model.Devices)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@device.Brand @device.Model</div>
                                    <small class="text-muted">SN: @device.SerialNumber</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@device.DeviceType</span>
                                </td>
                                <td>
                                    @if (device.Student != null)
                                    {
                                        <a asp-action="StudentDetail" asp-route-id="@device.StudentId" class="text-decoration-none">
                                            @device.Student.FirstName @device.Student.LastName
                                        </a>
                                        <br />
                                        <small class="text-muted">@device.Student.StudentNumber</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Unknown</span>
                                    }
                                </td>
                                <td>
                                    @switch (device.Status)
                                    {
                                        case PaScan.Enums.DeviceStatus.ACTIVE:
                                            <span class="badge bg-success">ACTIVE</span>
                                            break;
                                        case PaScan.Enums.DeviceStatus.REVOKED:
                                            <span class="badge bg-danger">REVOKED</span>
                                            break;
                                        case PaScan.Enums.DeviceStatus.EXPIRED:
                                            <span class="badge bg-warning text-dark">EXPIRED</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@device.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="DeviceDetail" asp-route-id="@device.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
