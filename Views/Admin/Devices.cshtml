@model PaScan.Models.ViewModels.AdminDeviceListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Devices";
}

<div class="adm-page-header adm-rise">
    <p class="adm-page-kicker">Management</p>
    <h1 class="adm-page-title">Managed Devices</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="adm-alert adm-alert--success adm-rise"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="adm-alert adm-alert--error adm-rise"><i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]</div>
}

<div class="adm-card adm-rise adm-rise-d1">
    <div class="adm-table-wrap">
        <table class="adm-table paginated-table">
            <thead>
                <tr>
                    <th>Device</th>
                    <th>Type</th>
                    <th>Owner</th>
                    <th>Status</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Devices.Any())
                {
                    <tr><td colspan="5" class="adm-table-empty">No devices found.</td></tr>
                }
                else
                {
                    @foreach (var device in Model.Devices)
                    {
                        <tr>
                            <td>
                                <div class="adm-list-item-title">@device.Brand @device.Model</div>
                                <div class="adm-list-item-sub">SN: @device.SerialNumber</div>
                            </td>
                            <td><span class="adm-info-chip">@device.DeviceType</span></td>
                            <td>
                                @if (device.Student != null)
                                {
                                    <a asp-action="StudentDetail" asp-route-id="@device.StudentId" style="color:#2196F3; text-decoration:none;">
                                        @device.Student.FirstName @device.Student.LastName
                                    </a>
                                    <div class="adm-list-item-sub">@device.Student.StudentNumber</div>
                                }
                                else
                                {
                                    <span class="adm-text-muted">Unknown</span>
                                }
                            </td>
                            <td>
                                @switch (device.Status)
                                {
                                    case PaScan.Enums.DeviceStatus.ACTIVE:
                                        <span class="adm-badge adm-badge--active">ACTIVE</span>
                                        break;
                                    case PaScan.Enums.DeviceStatus.REVOKED:
                                        <span class="adm-badge adm-badge--revoked">REVOKED</span>
                                        break;
                                    case PaScan.Enums.DeviceStatus.EXPIRED:
                                        <span class="adm-badge adm-badge--expired">EXPIRED</span>
                                        break;
                                    default:
                                        <span class="adm-badge adm-badge--inactive">@device.Status</span>
                                        break;
                                }
                            </td>
                            <td style="text-align:right;">
                                <a asp-action="DeviceDetail" asp-route-id="@device.Id" class="adm-btn-ghost adm-btn-sm">Details</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
