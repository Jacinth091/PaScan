@model PaScan.Models.ViewModels.AdminStudentDetailViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Replace RFID Card";
    var deviceId = Environment.MachineName;
}

<div class="adm-page-header adm-rise">
    <div class="adm-page-header-row">
        <div>
            <p class="adm-page-kicker">RFID</p>
            <h1 class="adm-page-title" style="-webkit-text-fill-color:#ff453a; color:#ff453a;">Replace Card</h1>
        </div>
        <a asp-action="ManageRfid" asp-route-id="@Model.Student.Id" class="adm-back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Back to Manage
        </a>
    </div>
</div>

<div style="max-width:550px;" class="adm-rise adm-rise-d1">
    <div class="adm-card adm-text-center" style="margin-bottom:1rem;">
        <h3 style="color:#fff; font-size:1.1rem; font-weight:600; margin-bottom:0.2rem;">@Model.Student.FirstName @Model.Student.LastName</h3>
        <p class="adm-text-muted" style="font-size:0.85rem;">@Model.Student.StudentNumber</p>
    </div>

    <div class="adm-card" style="border-top:2px solid #ff453a;">
        @if (Model.ActiveRfid != null)
        {
            <div class="adm-alert adm-alert--warning">
                <i class="bi bi-exclamation-triangle-fill"></i>
                Replacing will permanently invalidate the current card <strong>@Model.ActiveRfid.CardUid</strong>.
            </div>

            <div id="scanStatus" class="adm-scan-status waiting">
                <div class="adm-spinner"></div>
                <span>Waiting for physical card tap...</span>
            </div>

            <form asp-action="ReplaceRfid" asp-route-studentId="@Model.Student.Id" method="post" id="replaceForm">
                @Html.AntiForgeryToken()

                <div class="adm-form-group">
                    <label class="adm-form-label">New Card UID</label>
                    <input type="text" id="cardUidInput" name="newCardUid" class="adm-form-input adm-text-mono" required placeholder="UID will appear here" readonly style="font-size:1.1rem;" />
                    <div class="adm-form-hint">Scan the <strong>new</strong> card on the reader now. Listening to <strong>@deviceId</strong>.</div>
                </div>

                <div class="adm-form-group adm-mb-4">
                    <label class="adm-form-label">Reason for Replacement</label>
                    <select name="reason" class="adm-form-select" required>
                        <option value="LOST_CARD">Lost Card</option>
                        <option value="STOLEN_CARD">Stolen Card</option>
                        <option value="DAMAGED_CARD">Damaged Card</option>
                        <option value="ADMIN_REVOKED">Admin Revoked</option>
                    </select>
                </div>

                <button type="submit" id="submitBtn" class="adm-btn-danger adm-btn-block" style="padding:0.85rem;" disabled onclick="return confirm('Replace card? This will permanently invalidate the current card.')">
                    Confirm Replacement
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        const deviceId = "@deviceId";
        const cardInput = document.getElementById('cardUidInput');
        const statusAlert = document.getElementById('scanStatus');
        const submitBtn = document.getElementById('submitBtn');
        const form = document.getElementById('replaceForm');

        let isPolling = true;

        async function startPoll() {
            try {
                await fetch(`/scan/start-poll/${deviceId}`);
                console.log("Server notified: Admin is waiting for scan on this device.");
            } catch (e) { console.error("Failed to notify server:", e); }
        }

        async function pollForScan() {
            if (!isPolling) return;

            try {
                const response = await fetch(`/scan/check-scan/${deviceId}`);
                const data = await response.json();

                if (data.tagId) {
                    cardInput.value = data.tagId;
                    
                    statusAlert.classList.remove('waiting');
                    statusAlert.classList.add('success');
                    statusAlert.innerHTML = '<i class="bi bi-check-circle-fill"></i> New card detected successfully!';
                    
                    submitBtn.disabled = false;
                    isPolling = false;
                    cardInput.style.borderColor = '#32d74b';
                }
            } catch (error) {
                console.error('Polling error:', error);
            }

            if (isPolling) {
                setTimeout(pollForScan, 2000);
            }
        }

        startPoll().then(() => pollForScan());

        cardInput.addEventListener('input', function() {
            if (this.value.trim().length > 0) {
                submitBtn.disabled = false;
            } else {
                submitBtn.disabled = true;
            }
        });
    </script>
}
