@model PaScan.Models.ViewModels.AdminRequestListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Pending Requests";
}

<div class="adm-page-header adm-rise">
    <p class="adm-page-kicker">Approval Queue</p>
    <div class="adm-page-header-row">
        <h1 class="adm-page-title">Device Approval Queue</h1>
        <a asp-action="Dashboard" class="adm-back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Back to Dashboard
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="adm-alert adm-alert--success adm-rise"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="adm-alert adm-alert--error adm-rise"><i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]</div>
}

<div class="adm-table-actions adm-rise adm-rise-d1">
    <div class="adm-search-wrap">
        <div class="adm-search-icon"><i class="bi bi-search"></i></div>
        <input type="text" id="requestSearch" class="adm-form-input" placeholder="Search by Student, Device Type, or Brand/Model">
    </div>
</div>

<div class="adm-card adm-rise adm-rise-d2">
    <div class="adm-table-wrap">
        <table class="adm-table paginated-table" id="requestTable">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Device Type</th>
                    <th>Brand / Model</th>
                    <th>Submitted</th>
                    <th style="text-align:right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Requests.Any())
                {
                    @foreach (var req in Model.Requests)
                    {
                        <tr>
                            <td>
                                <div class="adm-list-item-title">@req.StudentName</div>
                                <div class="adm-list-item-sub">@req.StudentNumber</div>
                            </td>
                            <td><span class="adm-info-chip">@req.DeviceType</span></td>
                            <td>@req.Brand @req.Model</td>
                            <td>@req.SubmittedAt.ToString("MMM dd, yyyy")</td>
                            <td style="text-align:right;">
                                <a asp-action="RequestDetail" asp-route-id="@req.Id" class="adm-btn-ghost adm-btn-sm">Review</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="adm-table-empty">No pending requests found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('requestSearch');
    const table = document.getElementById('requestTable');
    if (!searchInput || !table) return;
    const rows = table.querySelectorAll('tbody tr');
    
    searchInput.addEventListener('keyup', function() {
        const term = this.value.toLowerCase();
        
        rows.forEach(row => {
            if (row.cells.length > 1) {
                const student = row.cells[0].textContent.toLowerCase();
                const deviceType = row.cells[1].textContent.toLowerCase();
                const brandModel = row.cells[2].textContent.toLowerCase();
                
                if (student.includes(term) || deviceType.includes(term) || brandModel.includes(term)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            }
        });
    });
});
</script>
