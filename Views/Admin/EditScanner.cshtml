@model PaScan.Models.ViewModels.ScannerEditViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Edit Scanner";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">Edit Scanner</h2>
                <a asp-action="Scanners" class="btn btn-sm btn-link text-decoration-none">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="EditScanner" asp-route-id="@Model.Id" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-4"></div>

                        <h5 class="card-title mb-4 border-bottom pb-2">Configuration</h5>
                        
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label small fw-bold">Name</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Location" class="form-label small fw-bold">Location</label>
                            <input asp-for="Location" class="form-control" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label small fw-bold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="ScannerType" class="form-label small fw-bold">Type</label>
                                <select asp-for="ScannerType" class="form-select">
                                    <option value="@PaScan.Enums.ScannerType.QR">QR Code</option>
                                    <option value="@PaScan.Enums.ScannerType.RFID">RFID</option>
                                    <option value="@PaScan.Enums.ScannerType.BOTH">Both</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label small fw-bold">Status</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="@PaScan.Enums.ScannerStatus.ACTIVE">Active</option>
                                    <option value="@PaScan.Enums.ScannerStatus.INACTIVE">Inactive</option>
                                    <option value="@PaScan.Enums.ScannerStatus.MAINTENANCE">Maintenance</option>
                                </select>
                            </div>
                        </div>

                        <h5 class="card-title mb-3 border-bottom pb-2 pt-2">Hardware Integration</h5>
                        
                        <div class="bg-light p-3 rounded mb-4">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-1">Current API Key</label>
                            <div class="font-monospace text-dark d-flex justify-content-between align-items-center">
                                <span>@(Model.CurrentApiKey ?? "None")</span>
                                <i class="bi bi-key text-muted"></i>
                            </div>
                        </div>

                        <div class="form-check mb-5">
                            <input asp-for="RotateApiKey" class="form-check-input" type="checkbox" id="rotateKeyCheck">
                            <label class="form-check-label small fw-bold text-danger" for="rotateKeyCheck">
                                Rotate API Key on Save (Invalidates current key)
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-pill shadow-sm">
                            Save Changes
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
