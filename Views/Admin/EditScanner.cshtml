@model PaScan.Models.ViewModels.ScannerEditViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Edit Scanner";
}

<div class="adm-page-header adm-rise">
    <div class="adm-page-header-row">
        <div>
            <p class="adm-page-kicker">Infrastructure</p>
            <h1 class="adm-page-title">Edit Scanner</h1>
        </div>
        <a asp-action="Scanners" class="adm-back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Back to List
        </a>
    </div>
</div>

<div style="max-width:600px;" class="adm-rise adm-rise-d1">
    <div class="adm-card">
        <form asp-action="EditScanner" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="adm-alert adm-alert--error" style="display:none;"></div>

            <div class="adm-form-legend">Configuration</div>

            <div class="adm-form-group">
                <label asp-for="Name" class="adm-form-label">Name</label>
                <input asp-for="Name" class="adm-form-input" />
                <span asp-validation-for="Name" class="adm-validation-error"></span>
            </div>

            <div class="adm-form-group">
                <label asp-for="Location" class="adm-form-label">Location</label>
                <input asp-for="Location" class="adm-form-input" />
                <span asp-validation-for="Location" class="adm-validation-error"></span>
            </div>

            <div class="adm-form-group">
                <label asp-for="Description" class="adm-form-label">Description</label>
                <textarea asp-for="Description" class="adm-form-textarea" rows="2"></textarea>
                <span asp-validation-for="Description" class="adm-validation-error"></span>
            </div>

            <div class="adm-form-row adm-mb-3">
                <div class="adm-form-group">
                    <label asp-for="ScannerType" class="adm-form-label">Type</label>
                    <select asp-for="ScannerType" class="adm-form-select">
                        <option value="@PaScan.Enums.ScannerType.QR">QR Code</option>
                        <option value="@PaScan.Enums.ScannerType.RFID">RFID</option>
                        <option value="@PaScan.Enums.ScannerType.BOTH">Both</option>
                    </select>
                </div>
                <div class="adm-form-group">
                    <label asp-for="Status" class="adm-form-label">Status</label>
                    <select asp-for="Status" class="adm-form-select">
                        <option value="@PaScan.Enums.ScannerStatus.ACTIVE">Active</option>
                        <option value="@PaScan.Enums.ScannerStatus.INACTIVE">Inactive</option>
                        <option value="@PaScan.Enums.ScannerStatus.MAINTENANCE">Maintenance</option>
                    </select>
                </div>
            </div>

            <div class="adm-form-legend" style="margin-top:1rem;">Hardware Integration</div>

            <div class="adm-credential-box" style="margin-bottom:1.2rem; text-align:left;">
                <div class="adm-detail-label">Current API Key</div>
                <div style="display:flex; justify-content:space-between; align-items:center; margin-top:0.3rem;">
                    <span class="adm-text-mono" style="color:#d2d2d7; font-size:0.88rem;">@(Model.CurrentApiKey ?? "None")</span>
                    <i class="bi bi-key adm-text-muted"></i>
                </div>
            </div>

            <div class="adm-form-check adm-mb-4">
                <input asp-for="RotateApiKey" type="checkbox" id="rotateKeyCheck">
                <label for="rotateKeyCheck" style="color:#ff453a; font-weight:600; font-size:0.88rem;">
                    Rotate API Key on Save (Invalidates current key)
                </label>
            </div>

            <button type="submit" class="adm-btn-primary adm-btn-block" style="padding:0.85rem;">Save Changes</button>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
