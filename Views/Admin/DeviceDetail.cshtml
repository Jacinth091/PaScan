@model PaScan.Models.ViewModels.AdminDeviceDetailViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Device Detail";
}

<div class="adm-breadcrumb adm-rise">
    <a asp-action="Devices">Devices</a>
    <span class="adm-breadcrumb-sep">›</span>
    <span class="adm-breadcrumb-current">@Model.Device.Brand @Model.Device.Model</span>
</div>

<div class="adm-page-header adm-rise">
    <div class="adm-page-header-row">
        <h1 class="adm-page-title">Device Information</h1>
        <div>
            @if (Model.Device.Status == PaScan.Enums.DeviceStatus.ACTIVE)
            {
                <span class="adm-badge adm-badge--active" style="font-size:0.85rem; padding:0.4rem 1rem;">ACTIVE</span>
            }
            else
            {
                <span class="adm-badge adm-badge--rejected" style="font-size:0.85rem; padding:0.4rem 1rem;">@Model.Device.Status</span>
            }
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="adm-alert adm-alert--success adm-rise"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="adm-alert adm-alert--error adm-rise"><i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]</div>
}

<div class="adm-row adm-rise adm-rise-d1" style="grid-template-columns:2fr 1fr;">
    <div>
        <div class="adm-card">
            <h3 class="adm-card-title" style="margin-bottom:1.2rem;">Specifications</h3>
            <div class="adm-detail-grid">
                <div class="adm-detail-item"><div class="adm-detail-label">Device Type</div><div class="adm-detail-value adm-detail-value--lg">@Model.Device.DeviceType</div></div>
                <div class="adm-detail-item"><div class="adm-detail-label">Serial Number</div><div class="adm-detail-value adm-detail-value--mono adm-detail-value--lg">@Model.Device.SerialNumber</div></div>
                <div class="adm-detail-item"><div class="adm-detail-label">Device Name</div><div class="adm-detail-value adm-detail-value--highlight">@Model.Device.DeviceName</div></div>
                <div class="adm-detail-item"><div class="adm-detail-label">Operating System</div><div class="adm-detail-value">@(Model.Device.OperatingSystem ?? "N/A")</div></div>
                <div class="adm-detail-item"><div class="adm-detail-label">Color</div><div class="adm-detail-value">@(Model.Device.Color ?? "N/A")</div></div>
            </div>
            <div style="margin-top:1rem;">
                <div class="adm-detail-label">Declared Purpose</div>
                <div class="adm-purpose-quote">"@Model.Device.Purpose"</div>
            </div>
            <div style="border-top:1px solid rgba(255,255,255,0.06); margin-top:1.5rem; padding-top:1.2rem;">
                <h3 class="adm-card-title" style="margin-bottom:1rem;">Hardware Details</h3>
                <div class="adm-detail-grid" style="grid-template-columns:1fr 1fr 1fr;">
                    <div class="adm-detail-item"><div class="adm-detail-label">Processor</div><div class="adm-detail-value">@(Model.Device.Processor ?? "N/A")</div></div>
                    <div class="adm-detail-item"><div class="adm-detail-label">Memory</div><div class="adm-detail-value">@(Model.Device.Memory ?? "N/A")</div></div>
                    <div class="adm-detail-item"><div class="adm-detail-label">Storage</div><div class="adm-detail-value">@(Model.Device.Storage ?? "N/A")</div></div>
                </div>
            </div>
        </div>

        <div class="adm-card">
            <h3 class="adm-card-title" style="margin-bottom:1rem;">Accessories</h3>
            @if (Model.Device.Accessories != null && Model.Device.Accessories.Any())
            {
                @foreach (var acc in Model.Device.Accessories)
                {
                    <div class="adm-list-item">
                        <span style="color:#d2d2d7;">@acc.AccessoryName</span>
                        <span class="adm-badge adm-badge--info">x@acc.Quantity</span>
                    </div>
                }
            }
            else
            {
                <p class="adm-text-muted">No accessories registered.</p>
            }
        </div>
    </div>

    <div>
        <div class="adm-card adm-text-center">
            <h3 class="adm-card-title" style="margin-bottom:1.2rem;">Access Credentials</h3>
            @if (Model.QrToken != null && Model.QrToken.Status == PaScan.Enums.TokenStatus.ACTIVE)
            {
                <div class="adm-credential-box">
                    <span class="adm-credential-icon" style="color:#32d74b;"><i class="bi bi-qr-code"></i></span>
                    <span class="adm-badge adm-badge--active" style="margin-bottom:0.5rem;">ACTIVE QR</span>
                    <p class="adm-text-muted" style="font-size:0.85rem; margin-top:0.5rem;">Expires: @Model.QrToken.ExpiresAt.ToString("MMM dd, yyyy")</p>
                </div>
                <form asp-action="RevokeQr" asp-route-id="@Model.Device.Id" method="post" onsubmit="return confirm('Are you sure you want to revoke this QR token?');">
                    @Html.AntiForgeryToken()
                    <div class="adm-form-group">
                        <select name="reason" class="adm-form-select">
                            <option value="ADMIN_REVOKED">Admin Revoked</option>
                            <option value="DEVICE_LOST">Device Lost</option>
                            <option value="DEVICE_STOLEN">Device Stolen</option>
                        </select>
                    </div>
                    <button type="submit" class="adm-btn-danger adm-btn-block">Revoke Token</button>
                </form>
            }
            else
            {
                <div class="adm-credential-box">
                    <span class="adm-credential-icon adm-text-muted"><i class="bi bi-qr-code"></i></span>
                    <span class="adm-badge adm-badge--inactive">NO ACTIVE QR</span>
                </div>
            }
        </div>

        <div class="adm-card">
            <h3 class="adm-card-title" style="margin-bottom:1rem;">Owner</h3>
            <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1rem;">
                <div class="adm-avatar adm-avatar--md">@Model.Device.Student.FirstName[0]@Model.Device.Student.LastName[0]</div>
                <div>
                    <div style="color:#e8e8ed; font-weight:600;">@Model.Device.Student.FirstName @Model.Device.Student.LastName</div>
                    <div class="adm-text-muted" style="font-size:0.85rem;">@Model.Device.Student.StudentNumber</div>
                </div>
            </div>
            <div class="adm-detail-item adm-mb-2">
                <div class="adm-detail-label">Course</div>
                <div class="adm-detail-value">@(Model.Device.Student.Course?.Name ?? "N/A")</div>
            </div>
            <a asp-action="StudentDetail" asp-route-id="@Model.Device.StudentId" class="adm-btn-ghost adm-btn-sm adm-btn-block">View Profile</a>
        </div>
    </div>
</div>
