@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "System Settings";
}

<div class="adm-page-header adm-rise">
    <p class="adm-page-kicker">Administration</p>
    <h1 class="adm-page-title">System Settings</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="adm-alert adm-alert--success adm-rise"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="adm-alert adm-alert--error adm-rise"><i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]</div>
}

<div style="max-width:700px;" class="adm-rise adm-rise-d1">
    <div class="adm-card adm-danger-zone">
        <h3 class="adm-card-title" style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1rem;">
            <i class="bi bi-exclamation-triangle-fill"></i> End Academic Year
        </h3>
        <p class="adm-text-muted" style="margin-bottom:1.5rem; line-height:1.6;">
            This action will expire all currently <strong style="color:#d2d2d7;">ACTIVE</strong> devices, QR tokens, and RFID cards across the entire campus.
            This should only be done at the very end of the school year, prior to the new enrollment/registration period.
        </p>

        <div class="adm-credential-box" style="text-align:left; margin-bottom:1.5rem;">
            <ul class="adm-danger-list">
                <li>All <code>ACTIVE</code> Devices will become <code>EXPIRED</code>.</li>
                <li>All <code>ACTIVE</code> QR Tokens will become <code>EXPIRED</code>.</li>
                <li>All <code>ACTIVE</code> RFID Cards will become <code>EXPIRED</code>.</li>
                <li>Students will need to click "Renew Device" to trigger an admin re-verification.</li>
            </ul>
        </div>

        <form asp-action="EndAcademicYear" method="post" onsubmit="return confirm('DANGER: Are you absolutely sure you want to END THE ACADEMIC YEAR? This will expire all active devices and tokens. This action cannot be undone.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="adm-btn-outline-danger" style="padding:0.75rem 1.5rem;">
                End Academic Year
            </button>
        </form>
    </div>
</div>
