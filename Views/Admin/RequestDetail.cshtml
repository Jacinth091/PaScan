@model PaScan.Models.ViewModels.AdminRequestDetailViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Review Request";
    var req = Model.Request;
}

<div class="adm-page-header adm-rise">
    <p class="adm-page-kicker">Review</p>
    <div class="adm-page-header-row">
        <div>
            <h1 class="adm-page-title">Review Device Request</h1>
            <p class="adm-page-subtitle">Submitted on @req.SubmittedAt.ToString("MMMM dd, yyyy HH:mm")</p>
        </div>
        <a asp-action="Requests" class="adm-back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Back to Queue
        </a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="adm-alert adm-alert--error adm-rise"><i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]</div>
}

<div class="adm-row adm-rise adm-rise-d1" style="grid-template-columns:2fr 1fr;">
    <div>
        <!-- Student Information -->
        <div class="adm-card">
            <h3 class="adm-card-title" style="margin-bottom:1rem; padding-bottom:0.6rem; border-bottom:1px solid rgba(255,255,255,0.06);">Student Information</h3>
            <div class="adm-detail-grid" style="grid-template-columns:1fr 1fr 1fr;">
                <div class="adm-detail-item">
                    <div class="adm-detail-label">Name</div>
                    <div class="adm-detail-value adm-detail-value--highlight">@req.StudentName</div>
                </div>
                <div class="adm-detail-item">
                    <div class="adm-detail-label">ID Number</div>
                    <div class="adm-detail-value adm-detail-value--highlight">@req.StudentNumber</div>
                </div>
                <div class="adm-detail-item">
                    <div class="adm-detail-label">Course</div>
                    <div class="adm-detail-value adm-detail-value--highlight">@req.CourseName</div>
                </div>
            </div>
        </div>

        <!-- Device Information -->
        <div class="adm-card">
            <h3 class="adm-card-title" style="margin-bottom:1rem; padding-bottom:0.6rem; border-bottom:1px solid rgba(255,255,255,0.06);">Device Details</h3>
            <div class="adm-detail-grid">
                <div class="adm-detail-item">
                    <div class="adm-detail-label">Device Type</div>
                    <div class="adm-detail-value adm-detail-value--lg">@req.DeviceType</div>
                </div>
                <div class="adm-detail-item">
                    <div class="adm-detail-label">Brand / Model</div>
                    <div class="adm-detail-value adm-detail-value--highlight">@req.Brand @req.Model</div>
                </div>
                <div class="adm-detail-item">
                    <div class="adm-detail-label">Device Name</div>
                    <div class="adm-detail-value">@req.DeviceName</div>
                </div>
                <div class="adm-detail-item">
                    <div class="adm-detail-label">Serial Number</div>
                    <div class="adm-detail-value adm-detail-value--mono adm-detail-value--highlight">@req.SerialNumber</div>
                </div>
            </div>
            <div style="margin-top:1rem;">
                <div class="adm-detail-label">Declared Purpose</div>
                <div class="adm-purpose-quote">"@req.Purpose"</div>
            </div>
            <div class="adm-detail-grid" style="margin-top:1.2rem; padding-top:1rem; border-top:1px solid rgba(255,255,255,0.06);">
                <div class="adm-detail-item">
                    <div class="adm-detail-label">Processor</div>
                    <div class="adm-detail-value">@(req.Processor ?? "N/A")</div>
                </div>
                <div class="adm-detail-item">
                    <div class="adm-detail-label">Storage</div>
                    <div class="adm-detail-value">@(req.Storage ?? "N/A")</div>
                </div>
                <div class="adm-detail-item">
                    <div class="adm-detail-label">Memory</div>
                    <div class="adm-detail-value">@(req.Memory ?? "N/A")</div>
                </div>
            </div>
        </div>

        <!-- Accessories -->
        <div class="adm-card">
            <h3 class="adm-card-title" style="margin-bottom:1rem; padding-bottom:0.6rem; border-bottom:1px solid rgba(255,255,255,0.06);">Accessories</h3>
            @if (req.Accessories.Any())
            {
                @foreach (var acc in req.Accessories)
                {
                    <div class="adm-list-item">
                        <span style="color:#d2d2d7;">@acc.AccessoryName</span>
                        <span class="adm-badge adm-badge--info">x@acc.Quantity</span>
                    </div>
                }
            }
            else
            {
                <p class="adm-text-muted">No accessories listed.</p>
            }
        </div>
    </div>

    <div>
        <div class="adm-card adm-sticky">
            <h3 class="adm-card-title" style="margin-bottom:1.2rem;">Decision</h3>

            @if (req.Status == PaScan.Enums.RegisterStatus.PENDING)
            {
                <form asp-action="Approve" asp-route-id="@req.Id" method="post" style="margin-bottom:1rem;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="adm-btn-success adm-btn-block" style="padding:0.85rem;">
                        <i class="bi bi-check-circle me-1"></i> Approve & Issue QR
                    </button>
                </form>

                <div style="border-top:1px solid rgba(255,255,255,0.06); padding-top:1.5rem; margin-top:1.5rem; text-align:center;">
                    <h4 style="color:#ff453a; font-size:0.92rem; font-weight:600; margin-bottom:1rem;">Reject Request</h4>
                    <form asp-action="Reject" asp-route-id="@req.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="adm-form-group">
                            <textarea name="rejectionReason" class="adm-form-textarea" placeholder="Reason for rejection..." required style="min-height:100px;"></textarea>
                        </div>
                        <button type="submit" class="adm-btn-outline-danger adm-btn-block adm-btn-sm">Reject Request</button>
                    </form>
                </div>
            }
            else
            {
                <div class="adm-text-center" style="padding:1.5rem 0;">
                    <div class="adm-text-muted" style="margin-bottom:0.75rem;">This request has been processed.</div>
                    <span class="adm-badge @(req.Status == PaScan.Enums.RegisterStatus.APPROVED ? "adm-badge--approved" : "adm-badge--rejected")" style="font-size:0.85rem; padding:0.4rem 1rem;">
                        @req.Status
                    </span>
                </div>
            }
        </div>
    </div>
</div>
