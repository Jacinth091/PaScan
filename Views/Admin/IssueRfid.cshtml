@model PaScan.Models.ViewModels.AdminStudentDetailViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Issue RFID Card";
    var deviceId = Environment.MachineName;
}

<div class="adm-page-header adm-rise">
    <div class="adm-page-header-row">
        <div>
            <p class="adm-page-kicker">RFID</p>
            <h1 class="adm-page-title">Issue RFID Card</h1>
        </div>
        <a asp-action="StudentDetail" asp-route-id="@Model.Student.Id" class="adm-back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Back to Profile
        </a>
    </div>
</div>

<div style="max-width:550px;" class="adm-rise adm-rise-d1">
    <div class="adm-card adm-text-center" style="margin-bottom:1rem;">
        <div class="adm-avatar adm-avatar--md" style="margin:0 auto 0.75rem;">@Model.Student.FirstName[0]@Model.Student.LastName[0]</div>
        <h3 style="color:#fff; font-size:1.1rem; font-weight:600; margin-bottom:0.2rem;">@Model.Student.FirstName @Model.Student.LastName</h3>
        <p class="adm-text-muted" style="font-size:0.85rem;">@Model.Student.StudentNumber &bull; @(Model.Student.Course?.Name ?? "N/A")</p>
    </div>

    <div class="adm-card" style="border-top:2px solid #2196F3;">
        <div id="scanStatus" class="adm-scan-status waiting">
            <div class="adm-spinner"></div>
            <span>Waiting for physical card tap...</span>
        </div>

        <form asp-action="IssueRfid" asp-route-studentId="@Model.Student.Id" method="post" id="issueForm">
            @Html.AntiForgeryToken()

            <div class="adm-form-group">
                <label class="adm-form-label">Bridge Identifier (Scanner Name)</label>
                <div class="adm-input-group">
                    <input type="text" id="bridgeIdInput" class="adm-form-input" value="@deviceId" placeholder="e.g. Front Gate or @deviceId" />
                    <button class="adm-btn-ghost" type="button" id="updateBridgeId">Connect</button>
                </div>
                <div class="adm-form-hint" style="margin-top:0.4rem;">Listening to: <strong id="currentListening" style="color:#d2d2d7;">@deviceId</strong></div>
            </div>

            <div class="adm-form-group">
                <label class="adm-form-label">Card UID</label>
                <input type="text" id="cardUidInput" name="CardUid" class="adm-form-input adm-text-mono" required placeholder="UID will appear here" readonly style="font-size:1.1rem;" />
                <div class="adm-form-hint">Scan the card on the reader now.</div>
            </div>

            <div class="adm-form-group adm-mb-4">
                <label class="adm-form-label">Semester Expiry</label>
                <input type="date" name="SemesterExpiresAt" class="adm-form-input" required value="@DateTime.Now.AddMonths(5).ToString("yyyy-MM-dd")" />
            </div>

            <button type="submit" id="submitBtn" class="adm-btn-primary adm-btn-block" style="padding:0.85rem;" disabled>
                Complete Registration
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let currentDeviceId = "@deviceId";
        const cardInput = document.getElementById('cardUidInput');
        const statusAlert = document.getElementById('scanStatus');
        const submitBtn = document.getElementById('submitBtn');
        const form = document.getElementById('issueForm');
        
        const bridgeIdInput = document.getElementById('bridgeIdInput');
        const updateBridgeBtn = document.getElementById('updateBridgeId');
        const currentListeningLabel = document.getElementById('currentListening');

        let isPolling = true;

        async function startPoll(id) {
            try {
                await fetch(`/scan/start-poll/${id}`);
                console.log(`Server notified: Admin is waiting for scan on ${id}`);
            } catch (e) { console.error("Failed to notify server:", e); }
        }

        async function pollForScan() {
            if (!isPolling) return;

            try {
                const response = await fetch(`/scan/check-scan/${currentDeviceId}`);
                const data = await response.json();

                if (data.tagId) {
                    cardInput.value = data.tagId;
                    
                    statusAlert.classList.remove('waiting');
                    statusAlert.classList.add('success');
                    statusAlert.innerHTML = '<i class="bi bi-check-circle-fill"></i> Card detected successfully!';
                    
                    submitBtn.disabled = false;
                    isPolling = false;
                    cardInput.style.borderColor = '#32d74b';
                }
            } catch (error) {
                console.error('Polling error:', error);
            }

            if (isPolling) {
                setTimeout(pollForScan, 2000);
            }
        }

        updateBridgeBtn.addEventListener('click', () => {
            const newId = bridgeIdInput.value.trim();
            if (newId) {
                currentDeviceId = newId;
                currentListeningLabel.innerText = newId;
                
                isPolling = true;
                cardInput.value = "";
                cardInput.style.borderColor = '';
                statusAlert.classList.remove('success');
                statusAlert.classList.add('waiting');
                statusAlert.innerHTML = '<div class="adm-spinner"></div><span>Waiting for physical card tap...</span>';
                
                startPoll(currentDeviceId);
            }
        });

        startPoll(currentDeviceId).then(() => pollForScan());

        cardInput.addEventListener('input', function() {
            submitBtn.disabled = this.value.trim().length === 0;
        });
    </script>
}
