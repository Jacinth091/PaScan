@model PaScan.Models.ViewModels.AdminStudentDetailViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Issue RFID Card";
    var deviceId = Environment.MachineName; // Simple way to link browser session to bridge app
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">Issue RFID Card</h2>
                <a asp-action="StudentDetail" asp-route-id="@Model.Student.Id" class="btn btn-sm btn-link text-decoration-none">
                    <i class="bi bi-arrow-left"></i> Back to Profile
                </a>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4 text-center">
                    <div class="avatar-md bg-light text-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.5rem; font-weight: bold;">
                        @Model.Student.FirstName[0]@Model.Student.LastName[0]
                    </div>
                    <h5 class="mb-1">@Model.Student.FirstName @Model.Student.LastName</h5>
                    <p class="text-muted small mb-0">@Model.Student.StudentNumber &bull; @(Model.Student.Course?.Name ?? "N/A")</p>
                </div>
            </div>

            <div class="card shadow-sm border-0 border-top border-primary border-4">
                <div class="card-body p-4 p-md-5">
                    <div id="scanStatus" class="alert alert-info d-flex align-items-center mb-4">
                        <div class="spinner-border spinner-border-sm me-3" role="status"></div>
                        <span>Waiting for physical card tap...</span>
                    </div>

                    <form asp-action="IssueRfid" asp-route-studentId="@Model.Student.Id" method="post" id="issueForm">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase">Bridge Identifier (Scanner Name)</label>
                            <div class="input-group mb-2">
                                <span class="input-group-text bg-light"><i class="bi bi-cpu"></i></span>
                                <input type="text" id="bridgeIdInput" class="form-control" value="@deviceId" placeholder="e.g. Front Gate or @deviceId" />
                                <button class="btn btn-outline-secondary" type="button" id="updateBridgeId">Connect</button>
                            </div>
                            <div class="form-text text-muted">Listening to: <strong id="currentListening">@deviceId</strong></div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase">Card UID</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-broadcast"></i></span>
                                <input type="text" id="cardUidInput" name="CardUid" class="form-control form-control-lg font-monospace" required placeholder="UID will appear here" readonly />
                            </div>
                            <div class="form-text text-muted">Scan the card on the reader now.</div>
                        </div>

                        <div class="mb-5">
                            <label class="form-label small fw-bold text-uppercase">Semester Expiry</label>
                            <input type="date" name="SemesterExpiresAt" class="form-control" required value="@DateTime.Now.AddMonths(5).ToString("yyyy-MM-dd")" />
                        </div>

                        <button type="submit" id="submitBtn" class="btn btn-primary w-100 py-2 fw-bold rounded-pill shadow-sm" disabled>
                            Complete Registration
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentDeviceId = "@deviceId";
        const cardInput = document.getElementById('cardUidInput');
        const statusAlert = document.getElementById('scanStatus');
        const submitBtn = document.getElementById('submitBtn');
        const form = document.getElementById('issueForm');
        
        const bridgeIdInput = document.getElementById('bridgeIdInput');
        const updateBridgeBtn = document.getElementById('updateBridgeId');
        const currentListeningLabel = document.getElementById('currentListening');

        let isPolling = true;

        async function startPoll(id) {
            try {
                await fetch(`/scan/start-poll/${id}`);
                console.log(`Server notified: Admin is waiting for scan on ${id}`);
            } catch (e) { console.error("Failed to notify server:", e); }
        }

        async function pollForScan() {
            if (!isPolling) return;

            try {
                const response = await fetch(`/scan/check-scan/${currentDeviceId}`);
                const data = await response.json();

                if (data.tagId) {
                    cardInput.value = data.tagId;
                    
                    statusAlert.classList.remove('alert-info');
                    statusAlert.classList.add('alert-success');
                    statusAlert.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i> Card detected successfully!';
                    
                    submitBtn.disabled = false;
                    isPolling = false;
                    cardInput.classList.add('is-valid');
                }
            } catch (error) {
                console.error('Polling error:', error);
            }

            if (isPolling) {
                setTimeout(pollForScan, 2000);
            }
        }

        updateBridgeBtn.addEventListener('click', () => {
            const newId = bridgeIdInput.value.trim();
            if (newId) {
                currentDeviceId = newId;
                currentListeningLabel.innerText = newId;
                
                // Reset state
                isPolling = true;
                cardInput.value = "";
                cardInput.classList.remove('is-valid');
                statusAlert.classList.remove('alert-success');
                statusAlert.classList.add('alert-info');
                statusAlert.innerHTML = '<div class="spinner-border spinner-border-sm me-3" role="status"></div><span>Waiting for physical card tap...</span>';
                
                startPoll(currentDeviceId);
                // pollForScan will continue running or restart if it was stopped
            }
        });

        // Initialize
        startPoll(currentDeviceId).then(() => pollForScan());

        cardInput.addEventListener('input', function() {
            submitBtn.disabled = this.value.trim().length === 0;
        });
    </script>
}
