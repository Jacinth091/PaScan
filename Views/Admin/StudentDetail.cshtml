@model PaScan.Models.ViewModels.AdminStudentDetailViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Student Profile";
}

<div class="adm-page-header adm-rise">
    <div class="adm-page-header-row">
        <div>
            <p class="adm-page-kicker">Profile</p>
            <h1 class="adm-page-title">Student Profile</h1>
        </div>
        <a asp-action="Students" class="adm-back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Back to Directory
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="adm-alert adm-alert--success adm-rise"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="adm-alert adm-alert--error adm-rise"><i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]</div>
}

<div class="adm-row adm-rise adm-rise-d1" style="grid-template-columns:1fr 2fr;">
    <div>
        <!-- Profile Card -->
        <div class="adm-card adm-text-center">
            <div class="adm-avatar adm-avatar--lg" style="margin:0 auto 1rem;">@Model.Student.FirstName[0]@Model.Student.LastName[0]</div>
            <h3 style="color:#fff; font-size:1.2rem; font-weight:600; margin-bottom:0.25rem;">@Model.Student.FirstName @Model.Student.LastName</h3>
            <p class="adm-text-muted" style="font-size:0.88rem; margin-bottom:1rem;">@Model.Student.StudentNumber</p>
            <span class="adm-badge @(Model.Student.IsActive ? "adm-badge--active" : "adm-badge--inactive")" style="margin-bottom:1.5rem;">
                @(Model.Student.IsActive ? "ACTIVE ACCOUNT" : "INACTIVE")
            </span>
            <div style="text-align:left; border-top:1px solid rgba(255,255,255,0.06); padding-top:1rem; margin-top:1rem;">
                <div class="adm-detail-item">
                    <div class="adm-detail-label">Email</div>
                    <div class="adm-detail-value" style="font-size:0.88rem;">@Model.Student.Email</div>
                </div>
                <div class="adm-detail-item">
                    <div class="adm-detail-label">Course</div>
                    <div class="adm-detail-value" style="font-size:0.88rem;">@(Model.Student.Course?.Name ?? "N/A")</div>
                </div>
            </div>
        </div>

        <!-- RFID Card Management -->
        <div class="adm-card">
            <h3 class="adm-card-title" style="margin-bottom:1.2rem;">RFID Credential</h3>
            @if (Model.ActiveRfid == null)
            {
                <div class="adm-alert adm-alert--warning" style="margin-bottom:1rem;">No active card issued.</div>
                <a asp-action="IssueRfid" asp-route-id="@Model.Student.Id" class="adm-btn-primary adm-btn-sm adm-btn-block">
                    <i class="bi bi-plus-circle"></i> Issue New Card
                </a>
            }
            else
            {
                <div class="adm-rfid-card-display active">
                    <div style="display:flex; align-items:center; justify-content:center; gap:0.5rem; color:#32d74b; margin-bottom:0.4rem;">
                        <i class="bi bi-credit-card-2-front" style="font-size:1.5rem;"></i>
                        <span style="font-weight:600;">Active Card</span>
                    </div>
                    <div class="adm-text-mono" style="color:#32d74b; font-size:0.88rem;">UID: @Model.ActiveRfid.CardUid</div>
                    <div style="color:#6e6e73; font-size:0.85rem; margin-top:0.3rem;">Expires: @Model.ActiveRfid.SemesterExpiresAt.ToString("MMM dd, yyyy")</div>
                </div>
                <a asp-action="ManageRfid" asp-route-id="@Model.Student.Id" class="adm-btn-ghost adm-btn-sm adm-btn-block">
                    <i class="bi bi-gear"></i> Manage Card
                </a>
            }
        </div>
    </div>

    <div>
        <!-- Registered Devices Table -->
        <div class="adm-card">
            <div class="adm-card-header">
                <h2 class="adm-card-title">Registered Devices</h2>
            </div>
            <div class="adm-table-wrap">
                <table class="adm-table paginated-table">
                    <thead>
                        <tr>
                            <th>Device</th>
                            <th>Type</th>
                            <th>Serial Number</th>
                            <th>Status</th>
                            <th style="text-align:right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Devices.Any())
                        {
                            @foreach (var device in Model.Devices)
                            {
                                <tr>
                                    <td style="font-weight:600; color:#e8e8ed;">@device.Brand @device.Model</td>
                                    <td><span class="adm-info-chip">@device.DeviceType</span></td>
                                    <td><span class="adm-text-mono" style="font-size:0.85rem;">@device.SerialNumber</span></td>
                                    <td>
                                        @if (device.Status == PaScan.Enums.DeviceStatus.ACTIVE)
                                        {
                                            <span class="adm-badge adm-badge--active">ACTIVE</span>
                                        }
                                        else
                                        {
                                            <span class="adm-badge adm-badge--rejected">@device.Status</span>
                                        }
                                    </td>
                                    <td style="text-align:right;">
                                        <a asp-action="DeviceDetail" asp-route-id="@device.Id" class="adm-btn-ghost adm-btn-sm">Details</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="adm-table-empty"><i class="bi bi-laptop" style="font-size:2rem; display:block; margin-bottom:0.5rem;"></i>No devices registered</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
