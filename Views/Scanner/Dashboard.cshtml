@{
    ViewData["Title"] = "Scanner Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="scn-rise">
    <div class="scn-card">
        <div class="scn-card-header">
            <h1 class="scn-card-title"><i class="bi bi-qr-code-scan"></i> Gate QR Scanner</h1>
            <span id="scannerStatus" class="scn-badge scn-badge--init">Initializing...</span>
        </div>

        <div class="scn-viewport" id="videoContainer">
            <video id="preview" playsinline></video>
            <canvas id="canvas"></canvas>

            <div id="scanOverlay" class="scn-overlay">
                <h3 id="scanResultStatus" class="scn-overlay-status"></h3>
                <p id="scanResultName" class="scn-overlay-name"></p>
                <p id="scanResultDevice" class="scn-overlay-device"></p>
                <p id="scanResultReason" class="scn-overlay-reason"></p>
            </div>
        </div>

        <div class="scn-controls">
            <button id="btnStart" class="scn-btn scn-btn-start"><i class="bi bi-play-fill"></i> Start Camera</button>
            <button id="btnStop" class="scn-btn scn-btn-stop" disabled><i class="bi bi-stop-fill"></i> Stop Camera</button>
        </div>

        <div class="scn-footer-hint">
            Please ensure the camera has clear visibility of the QR Code.
        </div>
    </div>

    <div id="errorAlert" class="scn-alert-error"></div>
</div>

@section Scripts {
    <!-- jsQR Library -->
    <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>
    
    <script>
        const video = document.getElementById("preview");
        const canvasElement = document.getElementById("canvas");
        const canvas = canvasElement.getContext("2d");
        
        const btnStart = document.getElementById("btnStart");
        const btnStop = document.getElementById("btnStop");
        const scannerStatus = document.getElementById("scannerStatus");
        const scanOverlay = document.getElementById("scanOverlay");
        const errorAlert = document.getElementById("errorAlert");
        
        let scanning = false;
        let scanPaused = false;

        // Audio files
        const successSound = new Audio('/assets/sounds/scanner-success.mp3');
        const errorSound = new Audio('/assets/sounds/scanner-error.mp3');
        
        function playScanSound(isSuccess = true) {
            const sound = isSuccess ? successSound : errorSound;
            sound.currentTime = 0;
            sound.play().catch(err => console.warn("Audio playback delayed or blocked:", err));
        }
        
        function updateStatus(text, badgeClass) {
            scannerStatus.textContent = text;
            scannerStatus.className = `scn-badge ${badgeClass}`;
        }
        
        btnStart.addEventListener("click", () => {
            // Warm up audio context for mobile/modern browsers
            successSound.play().then(() => { successSound.pause(); successSound.currentTime = 0; }).catch(() => {});
            errorSound.play().then(() => { errorSound.pause(); errorSound.currentTime = 0; }).catch(() => {});

            navigator.mediaDevices.getUserMedia({ video: { facingMode: "environment" } })
                .then(function(stream) {
                    video.srcObject = stream;
                    video.setAttribute("playsinline", true);
                    video.play();
                    
                    scanning = true;
                    scanPaused = false;
                    requestAnimationFrame(tick);
                    
                    btnStart.disabled = true;
                    btnStop.disabled = false;
                    updateStatus("Scanning Active", "scn-badge--active");
                    scanOverlay.style.display = "none";
                    errorAlert.style.display = "none";
                })
                .catch(function(err) {
                    updateStatus("Camera Error", "scn-badge--error");
                    errorAlert.textContent = "Could not access camera: " + err.message;
                    errorAlert.style.display = "block";
                });
        });
        
        btnStop.addEventListener("click", () => {
            if (video.srcObject) {
                video.srcObject.getTracks().forEach(track => track.stop());
            }
            scanning = false;
            btnStart.disabled = false;
            btnStop.disabled = true;
            updateStatus("Stopped", "scn-badge--stopped");
            scanOverlay.style.display = "none";
        });
        
        function tick() {
            if (!scanning) return;
            
            if (video.readyState === video.HAVE_ENOUGH_DATA && !scanPaused) {
                canvasElement.height = video.videoHeight;
                canvasElement.width = video.videoWidth;
                canvas.drawImage(video, 0, 0, canvasElement.width, canvasElement.height);
                
                var imageData = canvas.getImageData(0, 0, canvasElement.width, canvasElement.height);
                var code = jsQR(imageData.data, imageData.width, imageData.height, {
                    inversionAttempts: "dontInvert",
                });
                
                if (code) {
                    processScan(code.data);
                }
            }
            
            requestAnimationFrame(tick);
        }
        
        function processScan(tokenValue) {
            scanPaused = true;
            updateStatus("Processing...", "scn-badge--processing");
            
            fetch('/scan/qr', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ tokenValue: tokenValue })
            })
            .then(async res => {
                if (!res.ok) {
                    const errorData = await res.json().catch(() => ({}));
                    throw new Error(errorData.error || `Server returned ${res.status}`);
                }
                return res.json();
            })
            .then(data => {
                showScanResult(data);
                
                setTimeout(() => {
                    scanOverlay.style.display = "none";
                    if (scanning) {
                        scanPaused = false;
                        updateStatus("Scanning Active", "scn-badge--active");
                    }
                }, 3000);
            })
            .catch(err => {
                showScanResult({ allowed: false, denialReason: 'NETWORK_ERROR', studentName: err.message || 'Error connecting to server' });
                setTimeout(() => {
                    scanOverlay.style.display = "none";
                    if (scanning) {
                        scanPaused = false;
                        updateStatus("Scanning Active", "scn-badge--active");
                    }
                }, 3000);
            });
        }
        
        function showScanResult(data) {
            scanOverlay.style.display = "block";
            const statusEl = document.getElementById("scanResultStatus");
            
            document.getElementById("scanResultName").textContent = data.studentName || "Unknown Student";
            document.getElementById("scanResultDevice").textContent = data.deviceName || "";
            document.getElementById("scanResultReason").textContent = data.denialReason || "";
            
            if (data.allowed) {
                scanOverlay.className = 'scn-overlay granted';
                statusEl.innerHTML = '<i class="bi bi-check-circle-fill"></i> ACCESS GRANTED';
                updateStatus("Granted", "scn-badge--granted");
                playScanSound(true);
            } else {
                scanOverlay.className = 'scn-overlay denied';
                statusEl.innerHTML = '<i class="bi bi-x-circle-fill"></i> ACCESS DENIED';
                updateStatus("Denied", "scn-badge--denied");
                playScanSound(false);
            }
        }
        
        // Auto-start if ready
        updateStatus("Ready to Start", "scn-badge--ready");
    </script>
}