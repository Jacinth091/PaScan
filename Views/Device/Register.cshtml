@using PaScan.Enums
@model PaScan.Models.ViewModels.DeviceRequestViewModel
@{
    ViewData["Title"] = "Register Device";
    var accessories = Model.Accessories;
}

<div class="reg-wrap">
    <div id="regMainForm">
        <div class="reg-header stu-rise">
            <div>
                <p class="reg-page-sub">Device Registration</p>
                <h1 class="reg-page-title">Register New Device</h1>
            </div>
            <a asp-controller="Student" asp-action="Dashboard" class="reg-btn-ghost reg-btn-dashboard">Back to Dashboard</a>
        </div>

        @if (TempData["Info"] != null)
        {
            <div class="stu-alert stu-alert--info">@TempData["Info"]</div>
        }

        <div class="reg-step-rail stu-rise stu-rise-d1">
            <div class="reg-step-item">
                <div class="reg-step-dot active" id="dot0">1</div>
                <span class="reg-step-label active" id="lbl0">Device</span>
            </div>
            <div class="reg-step-item">
                <div class="reg-step-dot" id="dot1">2</div>
                <span class="reg-step-label" id="lbl1">Specs</span>
            </div>
            <div class="reg-step-item">
                <div class="reg-step-dot" id="dot2">3</div>
                <span class="reg-step-label" id="lbl2">Accessories</span>
            </div>
            <div class="reg-step-item">
                <div class="reg-step-dot" id="dot3">4</div>
                <span class="reg-step-label" id="lbl3">Review</span>
            </div>
        </div>

        <div class="reg-panel stu-rise stu-rise-d2">
            <form asp-action="Register" method="post" id="deviceRegisterForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="stu-validation-error" style="margin-bottom:1rem;"></div>

                <div class="reg-section visible" id="step0">
                    <p class="reg-eyebrow">Step 1 of 4</p>
                    <h2 class="reg-heading">Basic Information</h2>
                    <p class="reg-desc">Tell us about the device you want to bring on campus.</p>
                    <hr class="reg-divider" />

                    <div class="reg-row">
                        <div class="reg-field" style="margin:0">
                            <label asp-for="DeviceName">Device Name</label>
                            <input asp-for="DeviceName" placeholder="What do you call this device?" />
                            <span asp-validation-for="DeviceName" class="stu-validation-error"></span>
                        </div>
                        <div class="reg-field" style="margin:0">
                            <label asp-for="Brand">Brand</label>
                            <input asp-for="Brand" placeholder="e.g., Apple, Dell" />
                            <span asp-validation-for="Brand" class="stu-validation-error"></span>
                        </div>
                    </div>

                    <div class="reg-row">
                        <div class="reg-field" style="margin:0">
                            <label asp-for="DeviceType">Device Type</label>
                            <select asp-for="DeviceType" asp-items="Html.GetEnumSelectList<DeviceType>()"></select>
                            <span asp-validation-for="DeviceType" class="stu-validation-error"></span>
                        </div>
                        <div class="reg-field" style="margin:0">
                            <label asp-for="SerialNumber">Serial Number</label>
                            <input asp-for="SerialNumber" placeholder="Device serial number" />
                            <span asp-validation-for="SerialNumber" class="stu-validation-error"></span>
                        </div>
                    </div>

                    <div class="reg-row reg-row--align-start">
                        <div class="reg-col-stack">
                            <div class="reg-field" style="margin:0">
                                <label asp-for="Model">Model</label>
                                <input asp-for="Model" placeholder="e.g., Inspiron 15" />
                                <span asp-validation-for="Model" class="stu-validation-error"></span>
                            </div>
                            <div class="reg-field" style="margin:0">
                                <label asp-for="Color">Color</label>
                                <input asp-for="Color" placeholder="e.g., Space Grey" />
                            </div>
                        </div>
                        <div class="reg-field" style="margin:0">
                            <label asp-for="Purpose">Purpose on Campus</label>
                            <textarea asp-for="Purpose" rows="5" placeholder="Why are you bringing this device on campus?"></textarea>
                            <span asp-validation-for="Purpose" class="stu-validation-error"></span>
                        </div>
                    </div>

                    <div class="reg-btn-row">
                        <button type="button" class="reg-btn-primary" onclick="regGoStep(1)">Next</button>
                    </div>
                </div>

                <div class="reg-section" id="step1">
                    <p class="reg-eyebrow">Step 2 of 4</p>
                    <h2 class="reg-heading">Hardware Specifications</h2>
                    <p class="reg-desc">Optional but helps us verify your device at the gate.</p>
                    <hr class="reg-divider" />

                    <div class="reg-row">
                        <div class="reg-field" style="margin:0">
                            <label asp-for="OperatingSystem">Operating System</label>
                            <input asp-for="OperatingSystem" placeholder="e.g., Windows 11" />
                        </div>
                        <div class="reg-field" style="margin:0">
                            <label asp-for="Processor">Processor</label>
                            <input asp-for="Processor" placeholder="e.g., Intel i5-15400" />
                        </div>
                    </div>

                    <div class="reg-row">
                        <div class="reg-field" style="margin:0">
                            <label asp-for="Memory">Memory (RAM)</label>
                            <input asp-for="Memory" placeholder="e.g., 16GB DDR4" />
                        </div>
                        <div class="reg-field" style="margin:0">
                            <label asp-for="Storage">Storage</label>
                            <input asp-for="Storage" placeholder="e.g., 512GB SSD" />
                        </div>
                    </div>

                    <div class="reg-row">
                        <div class="reg-field" style="margin:0">
                            <label asp-for="MonitorSize">Monitor Size</label>
                            <input asp-for="MonitorSize" placeholder="e.g., 15.6&quot;" />
                        </div>
                        <div class="reg-field" style="margin:0">
                            <label asp-for="Motherboard">Motherboard</label>
                            <input asp-for="Motherboard" placeholder="e.g., ASUS B550" />
                        </div>
                    </div>

                    <div class="reg-row">
                        <div class="reg-field" style="margin:0">
                            <label asp-for="Casing">Casing</label>
                            <input asp-for="Casing" placeholder="e.g., NZXT H510" />
                        </div>
                        <div class="reg-field reg-field-toggle" style="margin-top: 25px ">
                            <label class="reg-toggle-wrap ">
                              
                               
                                <div style="margin-top: 2px;">
                                     <span class="reg-switch">
                                    <input asp-for="HasCdRom" type="checkbox" class="reg-switch-input" />
                                    <span class="reg-switch-slider"></span>
                                </span>
                                    <span class="reg-check-row-label" style="margin-left: 10px; margin-top: 20px;">CD-ROM / Optical Drive</span></div>
                                  
                            </label>
                        </div>
                    </div>

                    <div class="reg-btn-row">
                        <button type="button" class="reg-btn-ghost" onclick="regGoStep(0)">&larr; Back</button>
                        <button type="button" class="reg-btn-primary" onclick="regGoStep(2)">Next</button>
                    </div>
                </div>

                <div class="reg-section" id="step2">
                    <p class="reg-eyebrow">Step 3 of 4</p>
                    <h2 class="reg-heading">Accessories</h2>
                    <p class="reg-desc">List every accessory you're bringing with this device. Guards cross-check this list on exit.</p>
                    <hr class="reg-divider" />

                    <div class="reg-acc-shell">
                        <div class="reg-acc-head">
                            <span class="reg-acc-label">Accessories</span>
                            <span class="acc-counter" id="acc-counter">0/10</span>
                        </div>

                        <div class="acc-limit-banner" id="acc-limit-banner">
                            Maximum of 10 accessories reached. Remove one to add another.
                        </div>

                        <div class="acc-empty" id="acc-empty">No accessories added yet. Click below to add one.</div>

                        <div id="reg-acc-container">
                            @if (accessories != null)
                            {
                                @for (int i = 0; i < accessories.Count; i++)
                                {
                                    <div class="acc-card" draggable="true" data-index="@i">
                                        <span class="acc-drag-handle" title="Drag to reorder">⠿</span>
                                        <div class="acc-card-body">
                                            <div class="acc-fields">
                                                <input class="acc-name-input"
                                                       name="Accessories[@i].AccessoryName"
                                                       value="@accessories[i].AccessoryName"
                                                       placeholder="Accessory name (e.g., Charger)" />
                                                <input class="acc-notes-input"
                                                       name="Accessories[@i].Notes"
                                                       placeholder="Notes (optional)" />
                                            </div>
                                            <div class="acc-actions">
                                                <div class="acc-qty-wrap">
                                                    <button type="button" class="acc-qty-btn" onclick="accQtyChange(this,-1)">−</button>
                                                    <input class="acc-qty-input"
                                                           type="number"
                                                           name="Accessories[@i].Quantity"
                                                           value="@accessories[i].Quantity"
                                                           min="1"
                                                           max="99" />
                                                    <button type="button" class="acc-qty-btn" onclick="accQtyChange(this,1)">+</button>
                                                </div>
                                                <button type="button" class="acc-remove-btn" onclick="accRemove(this)" title="Remove">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none">
                                                        <path d="M3 6h18M8 6V4h8v2m-9 0v14h10V6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                                    </svg>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <button type="button" class="acc-add-upgraded" id="reg-add-acc-btn">+ Add Accessory</button>

                        <div class="reg-info-hint">
                            <p>Accessories are cross-checked when you exit. Drag cards to reorder. Make sure this list is accurate and complete.</p>
                        </div>
                    </div>

                    <div class="reg-btn-row">
                        <button type="button" class="reg-btn-ghost" onclick="regGoStep(1)">&larr; Back</button>
                        <button type="button" class="reg-btn-primary" onclick="regGoStep(3)">Next</button>
                    </div>
                </div>

                <div class="reg-section" id="step3">
                    <p class="reg-eyebrow">Step 4 of 4</p>
                    <h2 class="reg-heading">Review &amp; Submit</h2>
                    <p class="reg-desc">Double-check everything before submitting. Mismatches may delay approval.</p>
                    <hr class="reg-divider" />

                    <div class="reg-review-grid">
                        <div class="reg-review-card" id="reg-review-basic"></div>
                        <div class="reg-review-stack">
                            <div class="reg-review-card" id="reg-review-specs"></div>
                            <div class="reg-review-card" id="reg-review-acc"></div>
                        </div>
                    </div>

                    <div class="reg-btn-row">
                        <button type="button" class="reg-btn-ghost" onclick="regGoStep(2)">&larr; Back</button>
                        <button type="submit" id="regSubmitBtn" class="reg-btn-primary">Submit Registration</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var curStep = 0;
    var MAX_ACC = 10;

    function escapeHtml(value) {
        return (value || '').toString()
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function getInputValue(name) {
        var el = document.querySelector('[name="' + name + '"]');
        return el ? el.value.trim() : '';
    }

    function validateStepOne() {
        var required = ['DeviceName', 'Brand', 'Model', 'SerialNumber', 'Purpose'];
        var missing = required.filter(function (fieldName) {
            return getInputValue(fieldName) === '';
        });

        if (missing.length > 0) {
            alert('Please complete all required basic information fields before proceeding.');
            return false;
        }

        return true;
    }

    window.regGoStep = function (n) {
        if (n > curStep && curStep === 0 && !validateStepOne()) {
            return;
        }

        var active = document.getElementById('step' + curStep);
        var next = document.getElementById('step' + n);
        if (!active || !next) return;

        active.classList.remove('visible');
        next.classList.add('visible');
        curStep = n;

        updateRail(n);
        if (n === 3) buildReview();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    function updateRail(step) {
        for (var i = 0; i < 4; i++) {
            var dot = document.getElementById('dot' + i);
            var lbl = document.getElementById('lbl' + i);
            if (!dot || !lbl) continue;

            dot.className = 'reg-step-dot';
            lbl.className = 'reg-step-label';
            dot.textContent = (i + 1).toString();

            if (i === step) {
                dot.classList.add('active');
                lbl.classList.add('active');
            }
        }
    }

    function rv(label, val) {
        var txt = (val || '').toString().trim();
        if (!txt) return '';
        return '<div class="reg-review-row"><span class="reg-rv-label">' + escapeHtml(label) + '</span><span class="reg-rv-val">' + escapeHtml(txt) + '</span></div>';
    }

    function buildReview() {
        var typeSelect = document.querySelector('[name="DeviceType"]');
        var typeText = typeSelect && typeSelect.selectedIndex >= 0 ? typeSelect.options[typeSelect.selectedIndex].text : '';

        var basic = '<div class="reg-review-title">Device Info</div>';
        basic += rv('Device Name', getInputValue('DeviceName'));
        basic += rv('Type', typeText);
        basic += rv('Brand', getInputValue('Brand'));
        basic += rv('Model', getInputValue('Model'));
        basic += rv('Serial No.', getInputValue('SerialNumber'));
        basic += rv('Color', getInputValue('Color'));
        basic += rv('Purpose', getInputValue('Purpose'));
        document.getElementById('reg-review-basic').innerHTML = basic;

        var specs = '<div class="reg-review-title">Hardware Specs</div>';
        specs += rv('Operating System', getInputValue('OperatingSystem'));
        specs += rv('Processor', getInputValue('Processor'));
        specs += rv('Memory', getInputValue('Memory'));
        specs += rv('Storage', getInputValue('Storage'));
        specs += rv('Monitor', getInputValue('MonitorSize'));
        specs += rv('Motherboard', getInputValue('Motherboard'));
        specs += rv('Casing', getInputValue('Casing'));
        var hasCdRom = document.querySelector('[name="HasCdRom"]');
        if (hasCdRom && hasCdRom.checked) {
            specs += rv('CD-ROM / Optical Drive', 'Yes');
        }
        if (specs === '<div class="reg-review-title">Hardware Specs</div>') {
            specs += '<div class="reg-review-empty">No specs provided.</div>';
        }
        document.getElementById('reg-review-specs').innerHTML = specs;

        var accCards = document.querySelectorAll('#reg-acc-container .acc-card');
        var accessories = '<div class="reg-review-title">Accessories</div>';
        var hasAccessories = false;

        accCards.forEach(function (card) {
            var nameEl = card.querySelector('.acc-name-input');
            var qtyEl = card.querySelector('.acc-qty-input');
            var notesEl = card.querySelector('.acc-notes-input');
            var name = nameEl ? nameEl.value.trim() : '';
            var qty = qtyEl ? qtyEl.value : '1';
            var notes = notesEl ? notesEl.value.trim() : '';

            if (name) {
                accessories += '<div class="reg-review-row"><span class="reg-rv-label">' + escapeHtml(name) + '</span><span class="reg-rv-val">&times; ' + escapeHtml(qty) + (notes ? ' &middot; ' + escapeHtml(notes) : '') + '</span></div>';
                hasAccessories = true;
            }
        });

        if (!hasAccessories) {
            accessories += '<div class="reg-review-empty">No accessories listed.</div>';
        }
        document.getElementById('reg-review-acc').innerHTML = accessories;
    }

    function getContainer() { return document.getElementById('reg-acc-container'); }
    function getCards() { return getContainer().querySelectorAll('.acc-card'); }

    function accUpdateUI() {
        var cards = getCards();
        var count = cards.length;
        var counter = document.getElementById('acc-counter');
        var addBtn = document.getElementById('reg-add-acc-btn');
        var banner = document.getElementById('acc-limit-banner');
        var empty = document.getElementById('acc-empty');

        counter.textContent = count + '/' + MAX_ACC;
        addBtn.disabled = count >= MAX_ACC;
        banner.style.display = count >= MAX_ACC ? 'flex' : 'none';
        empty.style.display = count === 0 ? 'block' : 'none';

        cards.forEach(function (card, i) {
            card.dataset.index = i;
            card.querySelectorAll('[name]').forEach(function (el) {
                el.name = el.name.replace(/Accessories\[\d+\]/, 'Accessories[' + i + ']');
            });
        });
    }

    window.accQtyChange = function (btn, delta) {
        var input = btn.parentElement.querySelector('.acc-qty-input');
        var current = parseInt(input.value, 10) || 1;
        input.value = Math.max(1, Math.min(99, current + delta));
    };

    window.accRemove = function (btn) {
        var card = btn.closest('.acc-card');
        if (!card) return;
        card.remove();
        accUpdateUI();
    };

    function accMakeCard(index) {
        var card = document.createElement('div');
        card.className = 'acc-card';
        card.draggable = true;
        card.dataset.index = index;
        card.innerHTML =
            '<span class="acc-drag-handle" title="Drag to reorder">⠿</span>' +
            '<div class="acc-card-body">' +
                '<div class="acc-fields">' +
                    '<input class="acc-name-input" name="Accessories[' + index + '].AccessoryName" placeholder="Accessory name (e.g., Charger)" />' +
                    '<input class="acc-notes-input" name="Accessories[' + index + '].Notes" placeholder="Notes (optional)" />' +
                '</div>' +
                '<div class="acc-actions">' +
                    '<div class="acc-qty-wrap">' +
                        '<button type="button" class="acc-qty-btn" onclick="accQtyChange(this,-1)">−</button>' +
                        '<input class="acc-qty-input" type="number" name="Accessories[' + index + '].Quantity" value="1" min="1" max="99" />' +
                        '<button type="button" class="acc-qty-btn" onclick="accQtyChange(this,1)">+</button>' +
                    '</div>' +
                    '<button type="button" class="acc-remove-btn" onclick="accRemove(this)" title="Remove">' +
                        '<svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M3 6h18M8 6V4h8v2m-9 0v14h10V6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
                    '</button>' +
                '</div>' +
            '</div>';

        getContainer().appendChild(card);
        accDragBind(card);
        return card;
    }

    document.getElementById('reg-add-acc-btn').addEventListener('click', function () {
        if (getCards().length >= MAX_ACC) return;
        var idx = getCards().length;
        var card = accMakeCard(idx);
        accUpdateUI();
        var nameInput = card.querySelector('.acc-name-input');
        if (nameInput) {
            nameInput.focus();
        }
    });

    var dragSrc = null;

    function accDragBind(card) {
        card.addEventListener('dragstart', function (e) {
            dragSrc = card;
            e.dataTransfer.effectAllowed = 'move';
        });

        card.addEventListener('dragover', function (e) {
            e.preventDefault();
        });

        card.addEventListener('drop', function (e) {
            e.preventDefault();
            if (!dragSrc || dragSrc === card) return;

            var container = getContainer();
            var cards = Array.from(getCards());
            var srcIdx = cards.indexOf(dragSrc);
            var destIdx = cards.indexOf(card);

            if (srcIdx < destIdx) {
                container.insertBefore(dragSrc, card.nextSibling);
            } else {
                container.insertBefore(dragSrc, card);
            }
            accUpdateUI();
        });
    }

    getCards().forEach(accDragBind);
    accUpdateUI();

    document.getElementById('deviceRegisterForm').addEventListener('submit', function () {
        var btn = document.getElementById('regSubmitBtn');
        if (!btn) return;
        setTimeout(function () {
            btn.disabled = true;
            btn.textContent = 'Submitting...';
        }, 0);
    });
})();
</script>
}
