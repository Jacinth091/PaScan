@model List<PaScan.Models.ViewModels.DeviceListItem>
@{
    ViewData["Title"] = "My Devices";
}

<div style="margin: 2rem 2.5rem 6rem;">
<div class="stu-page-header-row stu-rise" >
    <div>
        <p class="stu-page-kicker">Device Management</p>
        <h1 class="stu-page-title">My Devices</h1>
    </div>
   
</div>

<!-- Search & Filter Toolbar -->
<div class="mvp-toolbar stu-rise stu-rise-d1">
    <div style="display: flex;  justify-content: space-between; align-items: center; gap: 41rem;  flex: 1;">
          <a asp-controller="Student" asp-action="Dashboard" class="stu-btn-ghost">Back to Dashboard</a>
    <div class="mvp-search-wrap">
        
        <i class="bi bi-search"></i>
        <input type="text" id="mvpSearch" placeholder="Search by name, brand, model…" style="width: 800px; " autocomplete="off">
    </div>
    </div>
   
    <div class="mvp-filters">
        <span class="mvp-filter-label"><i class="bi bi-funnel"></i> Filter</span>
        <select id="mvpFilter">
            <option value="all">All Statuses</option>
            <option value="ACTIVE">Active</option>
            <option value="REVOKED">Revoked</option>
        </select>
    </div>
</div>

<div class="stu-card stu-rise stu-rise-d1">
    <table class="stu-table" id="mvpTable">
        <thead>
            <tr>
                <th>Device Name</th>
                <th>Type</th>
                <th>Brand</th>
                <th>Model</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="mvpTbody">
            @foreach (var device in Model)
            {
                var devBadge = device.Status switch
                {
                    PaScan.Enums.DeviceStatus.ACTIVE  => "stu-badge--active",
                    PaScan.Enums.DeviceStatus.EXPIRED => "stu-badge--expired",
                    PaScan.Enums.DeviceStatus.REVOKED => "stu-badge--revoked",
                    _ => "stu-badge--pending"
                };
                <tr data-status="@device.Status"
                    data-name="@device.DeviceName.ToLower()"
                    data-brand="@device.Brand.ToLower()"
                    data-model="@device.Model.ToLower()">
                    <td style="font-weight:600;color:#e5e5ea;">@device.DeviceName</td>
                    <td>@device.DeviceType</td>
                    <td>@device.Brand</td>
                    <td>@device.Model</td>
                    <td><span class="stu-badge @devBadge">@device.Status</span></td>
                    <td>
                        <a href="javascript:void(0);"
                           data-url="@Url.Action("DeviceDetail","Device",new{deviceId=device.Id})"
                           class="view-details-btn">
                            View QR &amp; Details
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="stu-table-empty">
                        <i class="bi bi-laptop" style="font-size:2rem;display:block;margin-bottom:.5rem;opacity:.3;"></i>
                        No approved devices yet. Register a device and wait for admin approval.
                    </td>
                </tr>
            }
            <tr id="mvpNoResults" style="display:none;">
                <td colspan="6" class="stu-table-empty">
                    <i class="bi bi-search" style="font-size:2rem;display:block;margin-bottom:.5rem;opacity:.3;"></i>
                    No devices match your search or filter.
                </td>
            </tr>
        </tbody>
    </table>
</div>

</div>


@section Modals {
    <!-- Modal -->
    <div id="modal-container">
        <div class="modal fade pm-modal" id="deviceModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body" id="deviceModalBody">
                        <div class="pm-loading"><div class="pm-spinner"></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
(function(){
    /* ── Modal ── */
    var modal = new bootstrap.Modal(document.getElementById('deviceModal'));
    var body  = document.getElementById('deviceModalBody');

    document.addEventListener('click', function(e){
        if (e.target.closest('.pm-close-btn, .ddm-close')) { modal.hide(); return; }

        var btn = e.target.closest('.view-details-btn');
        if (!btn) return;
        e.preventDefault();
        body.innerHTML = '<div class="pm-loading"><div class="pm-spinner"></div></div>';
        modal.show();
        fetch(btn.getAttribute('data-url'), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.text())
            .then(html => { body.innerHTML = html; })
            .catch(() => { body.innerHTML = '<div style="color:#ff453a;padding:2rem;text-align:center;">Error loading details. Please try again.</div>'; });
    });

    /* ── Search & Filter ── */
    var searchInput  = document.getElementById('mvpSearch');
    var filterSelect = document.getElementById('mvpFilter');
    var rows         = document.querySelectorAll('#mvpTbody tr[data-status]');
    var noResults    = document.getElementById('mvpNoResults');

    searchInput.addEventListener('input', applyFilter);
    filterSelect.addEventListener('change', applyFilter);

    function applyFilter(){
        var q = searchInput.value.trim().toLowerCase();
        var activeFilter = filterSelect.value;
        var visible = 0;

        rows.forEach(function(row){
            var status  = row.getAttribute('data-status');
            var name    = row.getAttribute('data-name');
            var brand   = row.getAttribute('data-brand');
            var model   = row.getAttribute('data-model');
            var matchFilter = (activeFilter === 'all' || status === activeFilter);
            var matchSearch = !q || name.includes(q) || brand.includes(q) || model.includes(q);
            var show = matchFilter && matchSearch;

            if (show) {
                row.style.display = '';
                // Small rAF delay so the browser paints the row before fading in
                requestAnimationFrame(function(){
                    row.classList.remove('mvp-hidden');
                });
                visible++;
            } else {
                row.classList.add('mvp-hidden');
                // Hide from layout after the fade-out transition completes
                row.addEventListener('transitionend', function handler(){
                    if (row.classList.contains('mvp-hidden')) row.style.display = 'none';
                    row.removeEventListener('transitionend', handler);
                });
            }
        });

        noResults.style.display = visible === 0 ? '' : 'none';
    }
})();
</script>
}
