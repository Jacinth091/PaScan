@model PaScan.Models.ViewModels.DeviceDetailViewModel
@{
    ViewData["Title"] = "Approved Device Details";
}

<div class="shell" style="padding: 2rem 0;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <h1 style="font-size: 2.5rem; font-weight: 700;">Approved Device Details</h1>
        <a asp-controller="Student" asp-action="Dashboard" style="font-size: 0.9rem;">&larr; Back to Dashboard</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background: #e6f4ea; color: #1e8e3e; padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background: #fce8e6; color: #d93025; padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">
            @TempData["Error"]
        </div>
    }

    <div style="display: flex; gap: 40px; margin-top: 20px;">
        <!-- Left: QR Code -->
        <div style="text-align: center; border: 1px solid #ccc; padding: 20px; border-radius: var(--radius-md); background: var(--apple-white);">
            <h3>Gate Access QR</h3>
            @if (!string.IsNullOrEmpty(Model.QrImageBase64) && Model.QrToken?.Status == PaScan.Enums.TokenStatus.ACTIVE && Model.Device.Status == PaScan.Enums.DeviceStatus.ACTIVE)
            {
                <img src="data:image/png;base64,@Model.QrImageBase64" alt="Device QR Code" style="width: 250px;" />
                <p><strong>Status:</strong> @Model.QrToken?.Status</p>
                <p><strong>Expires:</strong> @(Model.QrToken?.ExpiresAt.ToString("MMM dd, yyyy") ?? "N/A")</p>
            }
            else
            {
                <p style="color: red; margin: 2rem 0;">No active QR token found, token is expired, or device is not active.</p>
                
                @if (Model.Device.Status == PaScan.Enums.DeviceStatus.ACTIVE && Model.QrToken?.Status != PaScan.Enums.TokenStatus.REVOKED)
                {
                    <form asp-action="RenewQr" asp-route-deviceId="@Model.Device.Id" method="post">
                        <button type="submit" class="button-pill button-pill-primary">Renew QR</button>
                    </form>
                }
                else if (Model.Device.Status == PaScan.Enums.DeviceStatus.EXPIRED)
                {
                    <div style="margin-top: 1rem;">
                        <p style="color: #6e6e73; font-size: 0.9rem;">Your device registration has expired. You must request a renewal for admin re-verification.</p>
                        <a asp-action="RenewDevice" asp-route-deviceId="@Model.Device.Id" class="button-pill button-pill-primary" style="display: inline-block; text-decoration: none;">Renew Device Registration</a>
                    </div>
                }
            }
        </div>

        <!-- Right: Device Info -->
        <div style="flex: 1; border: 1px solid #ccc; padding: 20px; border-radius: var(--radius-md); background: var(--apple-white);">
            <h3>Device Info</h3>
            <ul>
                <li><strong>Device Name:</strong> @Model.Device.DeviceName</li>
                <li><strong>Brand/Model:</strong> @Model.Device.Brand @Model.Device.Model</li>
                <li><strong>Serial:</strong> @Model.Device.SerialNumber</li>
                <li><strong>Status:</strong> @Model.Device.Status</li>
                <li><strong>Declared Purpose:</strong> @Model.Device.Purpose</li>
            </ul>

            <h4>Hardware Specs</h4>
            <ul>
                <li><strong>OS:</strong> @(Model.Device.OperatingSystem ?? "N/A")</li>
                <li><strong>Processor:</strong> @(Model.Device.Processor ?? "N/A")</li>
                <li><strong>Memory:</strong> @(Model.Device.Memory ?? "N/A")</li>
                <li><strong>Storage:</strong> @(Model.Device.Storage ?? "N/A")</li>
            </ul>

            <h4>Accessories</h4>
            <ul>
                @foreach (var acc in Model.Device.Accessories)
                {
                    <li>@acc.AccessoryName (Qty: @acc.Quantity)</li>
                }
            </ul>
        </div>
    </div>
</div>
