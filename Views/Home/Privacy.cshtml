@{
    ViewData["Title"] = "Privacy Policy";
}

<style>
  @@import url('https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');

  :root {
    --black: #000000;
    --ink: #1d1d1f;
    --gray-f5: #f5f5f7;
    --gray-6e: #6e6e73;
    --white: #ffffff;
    --blue: #0071e3;
    --blue-dark: #0066cc;
    --blue-light: #2997ff;
    --border-soft: #d2d2d7;
    --border-mid: #86868b;
  }

  body.privacy-page {
    background:
      radial-gradient(circle at top left, rgba(0, 113, 227, 0.08), transparent 34%),
      radial-gradient(circle at top right, rgba(41, 151, 255, 0.08), transparent 32%),
      linear-gradient(180deg, #ffffff 0%, #f5f5f7 100%);
    color: var(--ink);
  }

  body.privacy-page .page-root {
    overflow: hidden;
  }

  .privacy-shell {
    width: min(1240px, calc(100vw - 40px));
    margin: 0 auto;
    height: 100%;
    padding:100px 0 18px;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 14px;
  }

  .privacy-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 18px;
    align-items: center;
    padding: 22px 24px;
    border: 1px solid var(--border-soft);
    border-radius: 28px;
    background: linear-gradient(135deg, #ffffff 0%, #fbfbfd 100%);
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.06);
  }

  .privacy-eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 12px;
  }

  .privacy-title {
    font-family: 'Inter Tight', 'Helvetica Neue', sans-serif;
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
    margin: 0;
  }

  .privacy-subtitle {
    margin-top: 10px;
    max-width: 760px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--gray-6e);
  }

  .privacy-chips {
    display: grid;
    gap: 10px;
    min-width: 280px;
  }

  .privacy-chip {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 18px;
    background: var(--gray-f5);
    border: 1px solid var(--border-soft);
  }

  .privacy-chip-icon {
    width: 40px;
    height: 40px;
    border-radius: 14px;
    background: rgba(0, 113, 227, 0.1);
    color: var(--blue);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  .privacy-chip strong {
    display: block;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--ink);
  }

  .privacy-chip span {
    display: block;
    margin-top: 2px;
    font-size: 12px;
    line-height: 1.3;
    color: var(--gray-6e);
  }

  .privacy-body {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
    gap: 14px;
    min-height: 0;
  }

  .privacy-panel,
  .privacy-side {
    min-height: 0;
    border-radius: 28px;
    border: 1px solid var(--border-soft);
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.05);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .privacy-panel {
    padding: 20px;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 14px;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .section-heading h2 {
    margin: 0;
    font-family: 'Inter Tight', 'Helvetica Neue', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .section-heading span {
    font-size: 12px;
    color: var(--gray-6e);
  }

  .policy-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    min-height: 0;
  }

  .policy-card {
    padding: 16px;
    border-radius: 22px;
    border: 1px solid var(--border-soft);
    background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .policy-card-top {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .policy-icon {
    width: 42px;
    height: 42px;
    border-radius: 14px;
    background: rgba(0, 113, 227, 0.1);
    color: var(--blue);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  .policy-card h3 {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
  }

  .policy-card p {
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--gray-6e);
  }

  .policy-points {
    display: grid;
    gap: 8px;
  }

  .policy-point {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 14px;
    background: var(--gray-f5);
    font-size: 13px;
    line-height: 1.35;
    color: var(--ink);
  }

  .policy-point i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--blue);
    flex: 0 0 auto;
  }

  .privacy-side {
    padding: 20px;
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .privacy-summary {
    padding: 18px;
    border-radius: 22px;
    background: linear-gradient(135deg, rgba(0, 113, 227, 0.08), rgba(255, 255, 255, 0.98));
    border: 1px solid rgba(0, 113, 227, 0.15);
    display: grid;
    gap: 12px;
  }

  .privacy-summary h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
  }

  .privacy-summary p {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--gray-6e);
  }

  .privacy-matrix {
    display: grid;
    gap: 8px;
  }

  .privacy-matrix-row {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding: 11px 12px;
    border-radius: 14px;
    background: var(--gray-f5);
    font-size: 13px;
  }

  .privacy-matrix-row strong {
    color: var(--ink);
    font-weight: 700;
    white-space: nowrap;
  }

  .privacy-matrix-row span {
    color: var(--gray-6e);
    text-align: right;
  }

  .privacy-actions {
    display: grid;
    gap: 10px;
  }

  .privacy-action-card {
    padding: 15px;
    border-radius: 18px;
    border: 1px solid var(--border-soft);
    background: #fff;
  }

  .privacy-action-card h4 {
    margin: 0 0 6px;
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
  }

  .privacy-action-card p {
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--gray-6e);
  }

  .privacy-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 18px;
    border-radius: 22px;
    border: 1px solid var(--border-soft);
    background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
  }

  .privacy-cta strong {
    display: block;
    margin-bottom: 4px;
    font-size: 14px;
    color: var(--ink);
  }

  .privacy-cta span {
    display: block;
    font-size: 12px;
    line-height: 1.4;
    color: var(--gray-6e);
  }

  .privacy-cta a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--blue);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .privacy-cta a:hover {
    text-decoration: none;
    background: var(--blue-dark);
  }

  @@media (max-width: 1100px) {
    .privacy-shell {
      width: min(1240px, calc(100vw - 28px));
      height: auto;
    }

    .privacy-body {
      grid-template-columns: 1fr;
    }

    .privacy-chips {
      min-width: 0;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @@media (max-width: 768px) {
    body.privacy-page .page-root {
      overflow: auto;
    }

    .privacy-shell {
      width: calc(100vw - 20px);
      padding: 12px 0 16px;
      gap: 12px;
      height: auto;
    }

    .privacy-hero,
    .privacy-panel,
    .privacy-side {
      padding: 16px;
      border-radius: 22px;
    }

    .privacy-hero {
      grid-template-columns: 1fr;
    }

    .privacy-chips {
      grid-template-columns: 1fr;
    }

    .policy-grid {
      grid-template-columns: 1fr;
    }

    .privacy-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<div class="privacy-shell">
  <section class="privacy-hero">
    <div>
      <p class="privacy-eyebrow">Transparent Operations</p>
      <h1 class="privacy-title">Privacy &amp; Data Protection</h1>
      <p class="privacy-subtitle">PaScan keeps only the records needed for access control, auditability, and support. The design favors data minimization, role-based access, and clear traceability.</p>
    </div>

    <div class="privacy-chips" aria-label="Privacy at a glance">
      <div class="privacy-chip">
        <div class="privacy-chip-icon"><i class="bi bi-database-lock"></i></div>
        <div>
          <strong>Collected</strong>
          <span>Identity, devices, tokens, scans</span>
        </div>
      </div>
      <div class="privacy-chip">
        <div class="privacy-chip-icon"><i class="bi bi-shield-check"></i></div>
        <div>
          <strong>Protected</strong>
          <span>Role-based access and audit logs</span>
        </div>
      </div>
      <div class="privacy-chip">
        <div class="privacy-chip-icon"><i class="bi bi-clock-history"></i></div>
        <div>
          <strong>Retained</strong>
          <span>Only for operations and compliance</span>
        </div>
      </div>
    </div>
  </section>

  <section class="privacy-body">
    <div class="privacy-panel">
      <div class="section-heading">
        <h2>What We Keep</h2>
        <span>Compact policy summary</span>
      </div>

      <div class="policy-grid">
        <article class="policy-card">
          <div class="policy-card-top">
            <div class="policy-icon"><i class="bi bi-person-vcard"></i></div>
            <div>
              <h3>Identity Records</h3>
              <p>Only the information needed to verify and support each campus account.</p>
            </div>
          </div>
          <div class="policy-points">
            <div class="policy-point"><i></i><span>Name, student ID, email, and contact details</span></div>
            <div class="policy-point"><i></i><span>Course enrollment for institutional verification</span></div>
          </div>
        </article>

        <article class="policy-card">
          <div class="policy-card-top">
            <div class="policy-icon"><i class="bi bi-phone"></i></div>
            <div>
              <h3>Device Records</h3>
              <p>Asset details tied to request approval and device access tracking.</p>
            </div>
          </div>
          <div class="policy-points">
            <div class="policy-point"><i></i><span>Device specifications and ownership verification</span></div>
            <div class="policy-point"><i></i><span>Serial numbers, approvals, and request timestamps</span></div>
          </div>
        </article>

        <article class="policy-card">
          <div class="policy-card-top">
            <div class="policy-icon"><i class="bi bi-activity"></i></div>
            <div>
              <h3>Audit Events</h3>
              <p>Operational logs kept for security review and incident handling.</p>
            </div>
          </div>
          <div class="policy-points">
            <div class="policy-point"><i></i><span>Token generation, renewal, and revocation events</span></div>
            <div class="policy-point"><i></i><span>Gate scans with timestamp and scanner location</span></div>
          </div>
        </article>

        <article class="policy-card">
          <div class="policy-card-top">
            <div class="policy-icon"><i class="bi bi-arrow-repeat"></i></div>
            <div>
              <h3>How It Is Used</h3>
              <p>Used for approvals, access validation, and incident review.</p>
            </div>
          </div>
          <div class="policy-points">
            <div class="policy-point"><i></i><span>Request review, device validation, and access decisions</span></div>
            <div class="policy-point"><i></i><span>Traceable history for audits and support</span></div>
          </div>
        </article>
      </div>
    </div>

    <aside class="privacy-side">
      <div class="privacy-summary">
        <h3>Security posture</h3>
        <p>PaScan relies on role-based access, protected actions, and detailed audit history so sensitive data stays visible only to authorized staff.</p>
        <div class="privacy-matrix">
          <div class="privacy-matrix-row"><strong>Access</strong><span>Approved staff only</span></div>
          <div class="privacy-matrix-row"><strong>Storage</strong><span>Encrypted at rest and in transit</span></div>
          <div class="privacy-matrix-row"><strong>Review</strong><span>Logged administrative activity</span></div>
        </div>
      </div>

      <div class="privacy-actions">
        <div class="privacy-action-card">
          <h4>Your controls</h4>
          <p>Students can review registered devices, token status, and access history in the portal and request card replacement, invalidation, or device removal when needed.</p>
        </div>
        <div class="privacy-action-card">
          <h4>Retention approach</h4>
          <p>Records are kept only as long as needed for audit integrity, operational support, and policy enforcement.</p>
        </div>
      </div>
    </aside>
  </section>

  <section class="privacy-cta">
    <div>
      <strong>Need help with privacy requests?</strong>
      <span>Contact your institution's IT support or security office for access requests, corrections, or concerns.</span>
    </div>
    <a href="/">Back to Home</a>
  </section>
</div>
