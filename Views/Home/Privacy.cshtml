@{
    ViewData["Title"] = "Privacy";
}

<section class="utility-page">
    <div class="shell">
        <article class="apple-panel">
            <p class="eyebrow">Privacy and Security</p>
            <h1 class="utility-title">PaScan Data and Privacy</h1>
            <p class="utility-lead">
                PaScan processes only the data required for campus security operations,
                role-based account access, and audit-traceable gate verification.
            </p>

            <div class="utility-list">
                <div>
                    <h2>Data Collected</h2>
                    <p>
                        Student identity data, device registration details, token lifecycle records,
                        and gate scan logs linked to scanner station activity.
                    </p>
                </div>
                <div>
                    <h2>Operational Use</h2>
                    <p>
                        Information is used for approval workflows, access validation decisions,
                        and incident review through searchable transaction history.
                    </p>
                </div>
                <div>
                    <h2>Retention and Audit</h2>
                    <p>
                        Historical records are retained to preserve audit integrity, including
                        token renewals, card replacements, and each gate scan decision.
                    </p>
                </div>
                <div>
                    <h2>Access Governance</h2>
                    <p>
                        Access is enforced by role and route authorization. Unauthorized users are
                        denied protected actions and redirected to approved login endpoints.
                    </p>
                </div>
            </div>
        </article>
    </div>
</section>
