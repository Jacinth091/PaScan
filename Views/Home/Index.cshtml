@{
    ViewData["Title"] = "PaScan";
}

<section class="neo-hero" aria-labelledby="neo-title">
    <div class="neo-shell">
        <div class="neo-head neo-rise">
            <h1 id="neo-title">Where Campus Device Access Is Managed.</h1>
            <p>Bring student requests, admin decisions, and gate validation into one reliable system.</p>
            <div class="neo-actions">
                <a class="button-pill button-pill-highlight" href="/auth/register/student">Create New Account</a>
                <a class="button-pill neo-outline" href="#neo-how">How it works</a>
            </div>
        </div>

        <article class="neo-showcase neo-rise neo-delay-1" aria-label="Workflow showcase">
            <img class="neo-showcase-image neo-showcase-image-1" src="~/images/background3.jpg" alt="Illustration of PaScan workflow with student request, admin approval, and gate scan." />
            <img class="neo-showcase-image neo-showcase-image-2" src="~/images/background4.jpg" alt="Illustration of PaScan workflow with student request, admin approval, and gate scan." />

            <div class="neo-showcase-text">
                <span class="neo-tag">Live Operations</span>
                <h2>Efficiently transform manual gate checks into digital campus control.</h2>
                <p>Modern loop: request, review, issue, validate, and log.</p>
            </div>
        </article>
    </div>
</section>

<section id="neo-how" class="neo-how-modern" aria-labelledby="neo-how-title">
    <div class="neo-shell">
        <div class="neo-how-modern-header neo-rise">
            <p class="neo-how-modern-kicker">How It Works</p>
            <h2 id="neo-how-title" class="neo-how-modern-title">Effortless Device Access, Verified in Seconds.</h2>
            <p class="neo-how-modern-subtitle">Experience a fluid, transparent process combining smart automated logic with robust, privacy-first security.</p>
        </div>

        <div class="neo-how-modern-timeline neo-rise neo-delay-1">
            <div class="neo-how-modern-card card-1">
                <div class="glass-bg"></div>
                <div class="card-content">
                    <div class="step-icon">
                        <span class="icon-pulse">1</span>
                    </div>
                    <h3>Register Device</h3>
                    <p>Submit device specs and ownership proof via our sleek student portal.</p>
                </div>
            </div>
            
            <div class="neo-how-modern-path"></div>

            <div class="neo-how-modern-card card-2">
                <div class="glass-bg"></div>
                <div class="card-content">
                    <div class="step-icon">
                        <span class="icon-pulse">2</span>
                    </div>
                    <h3>Smart Review</h3>
                    <p>Admins swiftly review and cross-check requests using our automated logic engine.</p>
                </div>
            </div>

            <div class="neo-how-modern-path"></div>

            <div class="neo-how-modern-card card-3">
                <div class="glass-bg"></div>
                <div class="card-content">
                    <div class="step-icon">
                        <span class="icon-pulse">3</span>
                    </div>
                    <h3>Secure & Scan</h3>
                    <p>Your RFID or QR code is your fast pass. Verified instantly at the gate.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="neo-help-modern" aria-labelledby="neo-help-title">
    <div class="neo-shell">
        <div class="neo-help-modern-header neo-rise">
            <p class="neo-kicker" style="color: var(--apple-blue);">Help Center</p>
            <h2 id="neo-help-title" class="neo-help-modern-title">Find the answers you need.</h2>
            <p class="neo-help-modern-subtitle">Browse through our documentation or quick answers to resolve your campus access questions securely.</p>
        </div>

        <div class="neo-help-modern-grid neo-rise neo-delay-1">
            
            <article class="neo-help-modern-card doc-card">
                <div class="card-glow"></div>
                <div class="card-content">
                    <div class="help-icon" style="color: var(--apple-blue);"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg></div>
                    <h3>Documentation</h3>
                    <p>Review process guides for requests, approvals, and gate scans.</p>
                    <a class="help-modern-link" href="#neo-how">View Guides &rarr;</a>
                </div>
            </article>

            <article class="neo-help-modern-card">
                <div class="card-glow" style="background: #32d74b;"></div>
                <div class="card-content">
                    <div class="help-icon" style="color: #32d74b;"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.9 1.2 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg></div>
                    <h3>Common Questions</h3>
                    <p>Got a quick question? Take a look at the most frequently asked questions.</p>
                    <a class="help-modern-link" href="#neo-faq-title">Browse FAQs &rarr;</a>
                </div>
            </article>

            <article class="neo-help-modern-card">
                <div class="card-glow" style="background: #a951f5;"></div>
                <div class="card-content">
                    <div class="help-icon" style="color: #a951f5;"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
                    <h3>Campus Policies</h3>
                    <p>Understand the rules and compliance standards for safe campus device use.</p>
                    <a class="help-modern-link" href="/Home/Privacy">Read Policies &rarr;</a>
                </div>
            </article>

        </div>
    </div>
</section>

<section class="neo-faq-modern" aria-labelledby="neo-faq-title">
    <div class="neo-shell neo-faq-modern-layout">
        <div class="neo-rise neo-faq-modern-content">
            <p class="neo-faq-modern-kicker">FAQ</p>
            <h2 id="neo-faq-title" class="neo-faq-modern-title">Questions teams ask most often.</h2>
            <div class="neo-faq-modern-list">
                
                <details class="neo-faq-modern-item" open>
                    <summary>
                        <h3>How long is QR access valid?</h3>
                        <span class="faq-icon-cross"></span>
                    </summary>
                    <div class="faq-answer">
                        <p>Default QR validity is 30 days unless revoked or renewed. You can configure this duration in the admin settings based on your campus policies.</p>
                    </div>
                </details>

                <details class="neo-faq-modern-item">
                    <summary>
                        <h3>What does denied scan mean?</h3>
                        <span class="faq-icon-cross"></span>
                    </summary>
                    <div class="faq-answer">
                        <p>Denied outcomes include precise reason logs, allowing admins to quickly troubleshoot and students to understand the rejection instantly.</p>
                    </div>
                </details>

                <details class="neo-faq-modern-item">
                    <summary>
                        <h3>Where are statuses visible?</h3>
                        <span class="faq-icon-cross"></span>
                    </summary>
                    <div class="faq-answer">
                        <p>Real-time statuses are completely transparent. Students and admins can track everything clearly through their dedicated live dashboards.</p>
                    </div>
                </details>
                
            </div>
        </div>
        <aside class="neo-faq-modern-side neo-rise neo-delay-1" aria-label="Support callout">
            <div class="glass-orb"></div>
            <div class="side-content">
                <h3>Need immediate action?</h3>
                <p>Open the login hub and use admin logs to resolve gate issues instantly. Experience zero downtime and complete visibility.</p>
                <a class="button-pill faq-modern-btn" href="/api/auth/login">Go to Login Hub <span class="arrow">&rarr;</span></a>
            </div>
        </aside>
    </div>
</section>

