@{
    ViewData["Title"] = "PaScan";
}

<section class="hero-chapter">
    <div class="shell hero-grid">
        <div>
            <p class="eyebrow">Campus Device Entry Management System</p>
            <h1 class="hero-title">Campus device access, verified in seconds.</h1>
            <p class="hero-copy">
                PaScan replaces manual pink slips with a structured registration workflow,
                admin approval queue, and live QR or RFID verification at campus gates.
            </p>
            <div class="hero-actions">
                <a class="button-pill button-pill-primary" href="/api/auth/login">Login</a>
            </div>
            <p class="hero-note">Built for real operations: registration, approval, issuance, and audit-ready gate logs.</p>
        </div>

        <div class="metric-strip" aria-label="Platform highlights">
            <article class="metric-card">
                <div class="metric-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                </div>
                <div>
                    <p class="metric-value">3 Roles</p>
                    <p class="metric-label">Student, Admin, Scanner</p>
                </div>
            </article>
            <article class="metric-card">
                <div class="metric-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                </div>
                <div>
                    <p class="metric-value">4 Required</p>
                    <p class="metric-label">Core transactions</p>
                </div>
            </article>
            <article class="metric-card">
                <div class="metric-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                </div>
                <div>
                    <p class="metric-value">30 Days</p>
                    <p class="metric-label">Default QR validity</p>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="chapter-light">
    <div class="shell">
        <h2 class="section-title">One platform for registration, control, and scanning</h2>
        <p class="section-copy">
            PaScan is designed for day-to-day campus operations: students submit complete device details,
            admins review and decide requests, and scanner stations validate access in real time.
        </p>

        <div class="feature-grid">
            <article class="feature-card">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                </div>
                <div class="feature-content">
                    <h3>Student Portal</h3>
                    <p>Submit device requests with serial and accessory details, then track status from one dashboard.</p>
                </div>
            </article>
            <article class="feature-card">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                </div>
                <div class="feature-content">
                    <h3>Admin Operations</h3>
                    <p>Process pending requests, issue RFID access, and maintain scanner readiness across all gates.</p>
                </div>
            </article>
            <article class="feature-card">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7V5a2 2 0 0 1 2-2h2"></path><path d="M17 3h2a2 2 0 0 1 2 2v2"></path><path d="M21 17v2a2 2 0 0 1-2 2h-2"></path><path d="M7 21H5a2 2 0 0 1-2-2v-2"></path><rect x="8" y="8" width="8" height="8" rx="1"></rect></svg>
                </div>
                <div class="feature-content">
                    <h3>Gate Verification</h3>
                    <p>Validate QR or RFID credentials and return clear allow or deny outcomes with logged reasons.</p>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="chapter-white">
    <div class="shell">
        <h2 class="section-title">Operational flow from request to gate entry</h2>
        <p class="section-copy">Every step is tracked and auditable, from student submission to final scan decision.</p>

        <div class="workflow">
            <article class="workflow-step">
                <h3>Submit Device Request</h3>
                <p>Students register device information, purpose, and accessories for review.</p>
            </article>
            <article class="workflow-step">
                <h3>Review and Provision Access</h3>
                <p>Admins approve or reject requests, then issue QR tokens or RFID access as needed.</p>
            </article>
            <article class="workflow-step">
                <h3>Validate at Gate</h3>
                <p>Scanner stations verify credential state and record every allow or deny event.</p>
            </article>
        </div>
    </div>
</section>

<section class="chapter-light">
    <div class="shell status-board">
        <h2 class="section-title">Clear status lifecycle across the whole system</h2>
        <div class="status-chip-row" aria-label="Status examples">
            <span class="status-chip status-chip--pending">PENDING</span>
            <span class="status-chip status-chip--approved">APPROVED</span>
            <span class="status-chip status-chip--rejected">REJECTED</span>
            <span class="status-chip status-chip--active">ACTIVE</span>
            <span class="status-chip status-chip--expired">EXPIRED</span>
            <span class="status-chip status-chip--revoked">REVOKED</span>
        </div>
        <p class="section-copy">
            Status labels and actions are mapped directly to backend enums, so students, admins,
            and scanners always see the same source of truth.
        </p>
    </div>
</section>
