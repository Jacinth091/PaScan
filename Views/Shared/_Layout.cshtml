<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PaScan</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/scanner.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pagination.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PaScan.styles.css" asp-append-version="true" />

    <style>

    .wordmark-dot {
    width: 30px; height: 30px;
    border-radius: 50%;
    background: #0071e3;
    }

    .brand-text:hover {
        text-decoration: none;
    }

    /* Navbar scroll-shrink effect */
    .dynamic-navbar-island {
        transition: background 0.35s ease, box-shadow 0.35s ease, padding 0.35s ease, top 0.35s ease;
    }

    .dynamic-navbar-island.scrolled {
        background: rgba(10, 10, 12, 0.92);
        backdrop-filter: blur(40px) saturate(200%);
        -webkit-backdrop-filter: blur(40px) saturate(200%);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.65), inset 0 1px 0 rgba(255,255,255,0.08);
        top: 0.75rem;
    }

    .dynamic-nav-links a.is-active {
        color: #fff;
        position: relative;
    }

    .dynamic-nav-links a.is-active::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.55rem;
        height: 2px;
        border-radius: 999px;
        background: #0071e3;
        box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.16);
    }

    html {
        scroll-padding-top: 0px;
    }
    </style>
</head>



@{
    bool isAuthPage = Context.Request.Path.StartsWithSegments("/auth");
    bool isStudentPage = Context.Request.Path.StartsWithSegments("/student");
    bool isAdminPage = Context.Request.Path.StartsWithSegments("/admin");
    bool isScannerPage = Context.Request.Path.StartsWithSegments("/scanner");
    bool isPrivacyPage = Context.Request.Path.StartsWithSegments("/Home/Privacy");
    var studentName = Context.Session.GetString("FirstName") ?? "";
    var studentLast = Context.Session.GetString("LastName") ?? "";
    var studentInitial = !string.IsNullOrEmpty(studentName) ? studentName.Substring(0, 1).ToUpper() : "S";
    var adminInitial = "A";
    var bodyClass = isPrivacyPage ? " class=\"privacy-page\"" : (isStudentPage ? " class=\"student-portal\"" : (isAdminPage ? " class=\"admin-portal\"" : (isScannerPage ? " class=\"scanner-portal\"" : "")));
}

@Html.Raw("<body" + bodyClass + ">")

    <div id="modal-root">
        @await RenderSectionAsync("Modals", required: false)
    </div>

    @if (!isAuthPage && !isStudentPage && !isAdminPage && !isScannerPage)
    {
        <div class="dynamic-navbar-island">
            <a class="dynamic-brand" asp-area="" asp-controller="Home" asp-action="Index" >
                <img src="~/images/logo.svg" alt="PaScan Logo" class="brand-logo" style="width: 32px; height: 32px;" />
                <span class="brand-text">PaScan</span>
            </a>
            
            <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" />
            <label for="nav-toggle" class="nav-toggle-label">
                <span class="hamburger"></span>
            </label>
            
            <nav class="dynamic-nav-links" aria-label="Primary navigation">
                <a asp-area="" asp-controller="Home" asp-action="Index" data-nav-link="home">Home</a>
                <a href="/#neo-help-section" data-nav-link="help">Help</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy" data-nav-link="privacy">Privacy</a>
                <a href="/#neo-faq-section" data-nav-link="faq">FAQ</a>
                <a class="dynamic-nav-cta mobile-cta" href="/auth/register/student">Register</a>
                <a class="dynamic-nav-cta mobile-cta" href="/auth/login">Login</a>
            </nav>

            <div class="desktop-cta-group">
                <a class="dynamic-nav-cta desktop-cta dynamic-nav-cta-outline" href="/auth/register/student">Register</a>
                <a class="dynamic-nav-cta desktop-cta" href="/auth/login">Login</a>
            </div>
        </div>
    }

    @if (isStudentPage)
    {
        <!-- Floating Glass Dock -->
        <nav class="stu-dock" id="stuDock" aria-label="Student navigation">
            <a class="stu-dock-item @(ViewData["Title"]?.ToString() == "Student Dashboard" ? "active" : "")" asp-controller="Student" asp-action="Dashboard" title="Dashboard">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
                <span class="stu-dock-label">Dashboard</span>
            </a>
            <a class="stu-dock-item @(ViewData["Title"]?.ToString() == "My Devices" ? "active" : "")" asp-controller="Device" asp-action="MyDevices" title="My Devices">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                <span class="stu-dock-label">Devices</span>
            </a>
            <a class="stu-dock-item @(ViewData["Title"]?.ToString() == "Register Device" ? "active" : "")" asp-controller="Device" asp-action="Register" title="Register Device">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                <span class="stu-dock-label">Register</span>
            </a>

            <div class="stu-dock-divider"></div>

            <!-- User avatar with popover -->
            <div class="stu-dock-user-wrap">
                <button class="stu-dock-avatar" id="dockAvatarBtn" aria-label="User menu" type="button">@studentInitial</button>
                <div class="stu-dock-popover" id="dockPopover">
                    <div class="stu-dock-popover-header">
                        <div class="stu-dock-popover-avatar">@studentInitial</div>
                        <div>
                            <div class="stu-dock-popover-name">@studentName @studentLast</div>
                            <div class="stu-dock-popover-role">Student</div>
                        </div>
                    </div>
                    <a class="stu-dock-popover-logout" asp-controller="Auth" asp-action="Logout">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        Logout
                    </a>
                </div>
            </div>
        </nav>

        <main class="stu-main" role="main">
            @RenderBody()
        </main>

        <script>
            // Toggle popover on avatar click
            (function () {
                const btn = document.getElementById('dockAvatarBtn');
                const pop = document.getElementById('dockPopover');
                if (!btn || !pop) return;

                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    pop.classList.toggle('show');
                });

                document.addEventListener('click', function (e) {
                    if (!pop.contains(e.target) && e.target !== btn) {
                        pop.classList.remove('show');
                    }
                });
            })();
        </script>
    }
    else if (isAdminPage)
    {
        <!-- Admin Floating Glass Dock -->
        <nav class="adm-dock" id="admDock" aria-label="Admin navigation">
            <a class="adm-dock-item @(ViewData["Title"]?.ToString() == "Admin Dashboard" ? "active" : "")" asp-controller="Admin" asp-action="Dashboard" title="Dashboard">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
                <span class="adm-dock-label">Dashboard</span>
            </a>
            <a class="adm-dock-item @(ViewData["Title"]?.ToString() == "Students" || ViewData["Title"]?.ToString() == "Student Profile" ? "active" : "")" asp-controller="Admin" asp-action="Students" title="Students">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span class="adm-dock-label">Students</span>
            </a>
            <a class="adm-dock-item @(ViewData["Title"]?.ToString() == "Devices" || ViewData["Title"]?.ToString() == "Device Detail" ? "active" : "")" asp-controller="Admin" asp-action="Devices" title="Devices">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                <span class="adm-dock-label">Devices</span>
            </a>
            <a class="adm-dock-item @(ViewData["Title"]?.ToString()?.Contains("Request") == true ? "active" : "")" asp-controller="Admin" asp-action="Requests" title="Requests">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
                <span class="adm-dock-label">Requests</span>
            </a>
            <a class="adm-dock-item @(ViewData["Title"]?.ToString()?.Contains("Scanner") == true ? "active" : "")" asp-controller="Admin" asp-action="Scanners" title="Scanners">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 7h.01"/><path d="M7 12h.01"/><path d="M12 7h.01"/><path d="M17 7h.01"/><path d="M12 12h.01"/><path d="M7 17h.01"/></svg>
                <span class="adm-dock-label">Scanners</span>
            </a>
            <a class="adm-dock-item @(ViewData["Title"]?.ToString()?.Contains("RFID") == true ? "active" : "")" asp-controller="Admin" asp-action="RfidCards" title="RFID Cards">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                <span class="adm-dock-label">RFID</span>
            </a>
            <a class="adm-dock-item @(ViewData["Title"]?.ToString() == "System Settings" ? "active" : "")" asp-controller="Admin" asp-action="Settings" title="Settings">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                <span class="adm-dock-label">Settings</span>
            </a>

            <div class="adm-dock-divider"></div>

            <div class="adm-dock-user-wrap">
                <button class="adm-dock-avatar" id="admAvatarBtn" aria-label="Admin menu" type="button">@adminInitial</button>
                <div class="adm-dock-popover" id="admPopover">
                    <div class="adm-dock-popover-header">
                        <div class="adm-dock-popover-avatar">@adminInitial</div>
                        <div>
                            <div class="adm-dock-popover-name">Administrator</div>
                            <div class="adm-dock-popover-role">Admin</div>
                        </div>
                    </div>
                    <a class="adm-dock-popover-logout" asp-controller="Auth" asp-action="Logout">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        Logout
                    </a>
                </div>
            </div>
        </nav>

        <main class="adm-main" role="main">
            @RenderBody()
        </main>

        <script>
            (function () {
                const btn = document.getElementById('admAvatarBtn');
                const pop = document.getElementById('admPopover');
                if (!btn || !pop) return;
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    pop.classList.toggle('show');
                });
                document.addEventListener('click', function (e) {
                    if (!pop.contains(e.target) && e.target !== btn) {
                        pop.classList.remove('show');
                    }
                });
            })();
        </script>
    }
    else if (isScannerPage)
    {
        <!-- Scanner Floating Glass Dock -->
        <nav class="scn-dock" id="scnDock" aria-label="Scanner navigation">
            <a class="scn-dock-item @(ViewData["Title"]?.ToString() == "Scanner Dashboard" ? "active" : "")" asp-controller="Scanner" asp-action="Dashboard" title="Dashboard">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
                <span class="scn-dock-label">Dashboard</span>
            </a>
            <div class="scn-dock-divider"></div>

            <div class="scn-dock-user-wrap">
                <button class="scn-dock-avatar" id="scnAvatarBtn" aria-label="Scanner menu" type="button">S</button>
                <div class="scn-dock-popover" id="scnPopover">
                    <div class="scn-dock-popover-header">
                        <div class="scn-dock-popover-avatar">S</div>
                        <div>
                            <div class="scn-dock-popover-name">Gate Scanner</div>
                            <div class="scn-dock-popover-role">Scanner</div>
                        </div>
                    </div>
                    <a class="scn-dock-popover-logout" asp-controller="Auth" asp-action="Logout">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        Logout
                    </a>
                </div>
            </div>
        </nav>

        <main class="scn-main" role="main">
            @RenderBody()
        </main>

        <script>
            (function () {
                const btn = document.getElementById('scnAvatarBtn');
                const pop = document.getElementById('scnPopover');
                if (!btn || !pop) return;
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    pop.classList.toggle('show');
                });
                document.addEventListener('click', function (e) {
                    if (!pop.contains(e.target) && e.target !== btn) {
                        pop.classList.remove('show');
                    }
                });
            })();
        </script>
    }
    else
    {
        <main class="page-root" role="main">
            @RenderBody()
        </main>
    }

    @if (!isAuthPage && !isStudentPage && !isAdminPage && !isScannerPage && !isPrivacyPage)
    {
        <footer class="neo-footer-modern">
            <div class="shell neo-footer-grid">
                <div class="footer-brand-col">
                    <a class="footer-brand" asp-area="" asp-controller="Home" asp-action="Index">PaScan</a>
                    <p>Campus device entry management with status clarity, scan security, and full traceability. Protecting your campus one scan at a time.</p>
                    <div class="footer-socials">
                        <a href="#" aria-label="Twitter"><span class="social-icon"></span></a>
                        <a href="#" aria-label="LinkedIn"><span class="social-icon"></span></a>
                        <a href="#" aria-label="Github"><span class="social-icon"></span></a>
                    </div>
                </div>
                
                <div class="footer-links-col">
                    <h3>Platform</h3>
                    <a href="/#neo-how">How it Works</a>
                    <a href="/auth/register/student">Register Device</a>
                    <a href="/auth/login">Admin Dashboard</a>
                </div>

                <div class="footer-links-col">
                    <h3>Support</h3>
                    <a href="#">Help Center</a>
                    <a href="#">Gate Scanning Guides</a>
                    <a href="#">API Documentation</a>
                </div>

                <div class="footer-links-col">
                    <h3>Legal</h3>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                    <a href="#">Terms of Service</a>
                    <a href="#">Data Security</a>
                </div>
            </div>
            
            <div class="shell">
                <div class="footer-bottom">
                    <p>&copy; 2026 Admin Gate Systems &amp; PaScan. All rights reserved.</p>
                    <div class="footer-bottom-links">
                    </div>
                </div>
            </div>
            
            <div class="footer-glow glow-1"></div>
            <div class="footer-glow glow-2"></div>
        </footer>
    }

    @if (!isAuthPage && !isStudentPage && !isAdminPage && !isScannerPage)
    {
        <script>
            (function () {
                const links = Array.from(document.querySelectorAll('.dynamic-nav-links a[data-nav-link]'));
                if (!links.length) return;

                const sectionOrder = [
                    { id: 'neo-help-section', key: 'help' },
                    { id: 'neo-faq-section', key: 'faq' }
                ];
                const activeOffset = 500;

                const setActive = (key) => {
                    links.forEach((link) => {
                        const isActive = link.getAttribute('data-nav-link') === key;
                        link.classList.toggle('is-active', isActive);
                        if (isActive) {
                            link.setAttribute('aria-current', 'page');
                        } else {
                            link.removeAttribute('aria-current');
                        }
                    });
                };

                const resolveState = () => {
                    const path = window.location.pathname.replace(/\/$/, '') || '/';

                    if (path.toLowerCase() === '/home/privacy'.toLowerCase()) {
                        setActive('privacy');
                        return;
                    }

                    if (path === '/' || path === '') {
                        let activeKey = 'home';
                        const scrollPosition = window.scrollY + activeOffset;

                        for (const section of sectionOrder) {
                            const element = document.getElementById(section.id);
                            if (!element) continue;

                            if (scrollPosition >= element.offsetTop) {
                                activeKey = section.key;
                            }
                        }

                        setActive(activeKey);
                        return;
                    }

                    setActive('home');
                };

                resolveState();
                window.addEventListener('hashchange', resolveState);
                window.addEventListener('scroll', resolveState, { passive: true });
            })();
        </script>
    }

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/pagination.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
@Html.Raw("</body>")
</html>
