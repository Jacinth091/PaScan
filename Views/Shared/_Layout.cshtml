<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PaScan</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PaScan.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="global-nav" role="banner">
        <div class="shell nav-shell">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">PaScan</a>
            <button class="menu-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="primary-menu" data-menu-toggle>
                <span class="menu-toggle-line"></span>
                <span class="menu-toggle-line"></span>
            </button>
            <div id="primary-menu" class="menu-panel" data-menu-panel>
                <nav class="menu-links" aria-label="Primary navigation">
                    <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </nav>
                <a class="button-pill button-pill-primary menu-cta" href="/api/auth/login">Login</a>
            </div>
        </div>
    </header>

    <main class="page-root" role="main">
        @RenderBody()
    </main>

    <footer class="global-footer">
        <div class="shell footer-shell">
            <p>&copy; 2026 PaScan. Campus Device Entry Management System.</p>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
