<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PaScan</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PaScan.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="global-nav" role="banner">
        <div class="shell nav-shell">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">PaScan</a>
            <button class="menu-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="primary-menu" data-menu-toggle>
                <span class="menu-toggle-line"></span>
                <span class="menu-toggle-line"></span>
            </button>
            <div id="primary-menu" class="menu-panel" data-menu-panel>
                <nav class="menu-links" aria-label="Primary navigation">
                    <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-area="" asp-controller="Admin" asp-action="Dashboard">Admin</a>
                    <a asp-area="" asp-controller="Admin" asp-action="Requests">Requests</a>
                    <a asp-area="" asp-controller="Admin" asp-action="Students">Students</a>
                    <a asp-area="" asp-controller="Admin" asp-action="Devices">Devices</a>
                    <a asp-area="" asp-controller="Admin" asp-action="RfidCards">RFID</a>
                    <a asp-area="" asp-controller="Admin" asp-action="Settings">Settings</a>
                </nav>
                <a class="button-pill button-pill-primary menu-cta" asp-controller="Auth" asp-action="LoginSelector">Login</a>
            </div>
        </div>
    </header>

    <main class="page-root" role="main">
        @RenderBody()
    </main>

    <footer class="global-footer">
        <div class="shell footer-shell">
            <p>&copy; 2026 PaScan. Campus Device Entry Management System.</p>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
