<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PaScan</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PaScan.styles.css" asp-append-version="true" />

    <style>

    .wordmark-dot {
    width: 30px; height: 30px;
    border-radius: 50%;
    background: #0071e3;
    }

    .brand-text:hover {
        text-decoration: none;
    }

    /* Navbar scroll-shrink effect */
    .dynamic-navbar-island {
        transition: background 0.35s ease, box-shadow 0.35s ease, padding 0.35s ease, top 0.35s ease;
    }

    .dynamic-navbar-island.scrolled {
        background: rgba(10, 10, 12, 0.92);
        backdrop-filter: blur(40px) saturate(200%);
        -webkit-backdrop-filter: blur(40px) saturate(200%);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.65), inset 0 1px 0 rgba(255,255,255,0.08);
        top: 0.75rem;
    }
    </style>
</head>



@{
    bool isAuthPage = Context.Request.Path.StartsWithSegments("/auth");
    bool isStudentPage = Context.Request.Path.StartsWithSegments("/student");
    var studentName = Context.Session.GetString("FirstName") ?? "";
    var studentLast = Context.Session.GetString("LastName") ?? "";
    var studentInitial = !string.IsNullOrEmpty(studentName) ? studentName.Substring(0, 1).ToUpper() : "S";
    var bodyClass = isStudentPage ? " class=\"student-portal\"" : "";
}

@Html.Raw("<body" + bodyClass + ">")

    @if (!isAuthPage && !isStudentPage)
    {
        <div class="dynamic-navbar-island">
            <a class="dynamic-brand" asp-area="" asp-controller="Home" asp-action="Index" >
                <div class="wordmark-dot"></div>
                <span class="brand-text">PaScan</span>
            </a>
            
            <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" />
            <label for="nav-toggle" class="nav-toggle-label">
                <span class="hamburger"></span>
            </label>
            
            <nav class="dynamic-nav-links" aria-label="Primary navigation">
                <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                <a href="/#neo-help-title">Help</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                <a href="/#neo-faq-title">FAQ</a>
                <a class="dynamic-nav-cta mobile-cta" href="/auth/register/student">Register</a>
                <a class="dynamic-nav-cta mobile-cta" href="/auth/login">Login</a>
            </nav>

            <div class="desktop-cta-group">
                <a class="dynamic-nav-cta desktop-cta dynamic-nav-cta-outline" href="/auth/register/student">Register</a>
                <a class="dynamic-nav-cta desktop-cta" href="/auth/login">Login</a>
            </div>
        </div>
    }

    @if (isStudentPage)
    {
        <!-- Floating Glass Dock -->
        <nav class="stu-dock" id="stuDock" aria-label="Student navigation">
            <a class="stu-dock-item @(ViewData["Title"]?.ToString() == "Student Dashboard" ? "active" : "")" asp-controller="Student" asp-action="Dashboard" title="Dashboard">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
                <span class="stu-dock-label">Dashboard</span>
            </a>
            <a class="stu-dock-item @(ViewData["Title"]?.ToString() == "My Devices" ? "active" : "")" asp-controller="Device" asp-action="MyDevices" title="My Devices">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                <span class="stu-dock-label">Devices</span>
            </a>
            <a class="stu-dock-item @(ViewData["Title"]?.ToString() == "Register Device" ? "active" : "")" asp-controller="Device" asp-action="Register" title="Register Device">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                <span class="stu-dock-label">Register</span>
            </a>

            <div class="stu-dock-divider"></div>

            <!-- User avatar with popover -->
            <div class="stu-dock-user-wrap">
                <button class="stu-dock-avatar" id="dockAvatarBtn" aria-label="User menu" type="button">@studentInitial</button>
                <div class="stu-dock-popover" id="dockPopover">
                    <div class="stu-dock-popover-header">
                        <div class="stu-dock-popover-avatar">@studentInitial</div>
                        <div>
                            <div class="stu-dock-popover-name">@studentName @studentLast</div>
                            <div class="stu-dock-popover-role">Student</div>
                        </div>
                    </div>
                    <a class="stu-dock-popover-logout" asp-controller="Auth" asp-action="Logout">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        Logout
                    </a>
                </div>
            </div>
        </nav>

        <main class="stu-main" role="main">
            @RenderBody()
        </main>

        <script>
            // Toggle popover on avatar click
            (function () {
                const btn = document.getElementById('dockAvatarBtn');
                const pop = document.getElementById('dockPopover');
                if (!btn || !pop) return;

                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    pop.classList.toggle('show');
                });

                document.addEventListener('click', function (e) {
                    if (!pop.contains(e.target) && e.target !== btn) {
                        pop.classList.remove('show');
                    }
                });
            })();
        </script>
    }
    else
    {
        <main class="page-root" role="main">
            @RenderBody()
        </main>
    }

    @if (!isAuthPage && !isStudentPage)
    {
        <footer class="neo-footer-modern">
            <div class="shell neo-footer-grid">
                <div class="footer-brand-col">
                    <a class="footer-brand" asp-area="" asp-controller="Home" asp-action="Index">PaScan</a>
                    <p>Campus device entry management with status clarity, scan security, and full traceability. Protecting your campus one scan at a time.</p>
                    <div class="footer-socials">
                        <a href="#" aria-label="Twitter"><span class="social-icon"></span></a>
                        <a href="#" aria-label="LinkedIn"><span class="social-icon"></span></a>
                        <a href="#" aria-label="Github"><span class="social-icon"></span></a>
                    </div>
                </div>
                
                <div class="footer-links-col">
                    <h3>Platform</h3>
                    <a href="/#neo-how">How it Works</a>
                    <a href="/auth/register/student">Register Device</a>
                    <a href="/auth/login">Admin Dashboard</a>
                </div>

                <div class="footer-links-col">
                    <h3>Support</h3>
                    <a href="#">Help Center</a>
                    <a href="#">Gate Scanning Guides</a>
                    <a href="#">API Documentation</a>
                </div>

                <div class="footer-links-col">
                    <h3>Legal</h3>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                    <a href="#">Terms of Service</a>
                    <a href="#">Data Security</a>
                </div>
            </div>
            
            <div class="shell">
                <div class="footer-bottom">
                    <p>&copy; 2026 Admin Gate Systems &amp; PaScan. All rights reserved.</p>
                    <div class="footer-bottom-links">
                    </div>
                </div>
            </div>
            
            <div class="footer-glow glow-1"></div>
            <div class="footer-glow glow-2"></div>
        </footer>
    }

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Sticky navbar scroll effect
        (function () {
            var navbar = document.querySelector('.dynamic-navbar-island');
            if (!navbar) return;
            function onScroll() {
                if (window.scrollY > 20) {
                    navbar.classList.add('scrolled');
                } else {
                    navbar.classList.remove('scrolled');
                }
            }
            window.addEventListener('scroll', onScroll, { passive: true });
            onScroll(); // run once on load
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
@Html.Raw("</body>")
</html>
