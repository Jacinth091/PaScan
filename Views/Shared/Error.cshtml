@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="utility-page">
    <div class="shell">
        <article class="apple-panel apple-panel-error">
            <p class="eyebrow">Request Failed</p>
            <h1 class="utility-title">An error occurred while processing your request.</h1>
            <p class="utility-lead">
                Retry the action once. If the issue continues, share the request ID with the admin or support team.
            </p>

            @if (Model.ShowRequestId)
            {
                <p class="error-code">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </p>
            }

            <div class="dev-note">
                <h2>Development Mode</h2>
                <p>
                    Switching to <strong>Development</strong> displays detailed exception data for local debugging only.
                </p>
                <p>
                    <strong>Do not enable Development in production.</strong>
                    It can expose sensitive information to end users.
                </p>
            </div>
        </article>
    </div>
</section>
